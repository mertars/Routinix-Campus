<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Arial, sans-serif;
    margin: 0;
    background: #FDFBF7;
    color: #2C221E;
  }
  .page { position: relative; width: 210mm; min-height: 297mm; padding: 18mm; }
  .header { display: flex; align-items: center; gap: 14px; border-bottom: 4px solid #D97706; padding-bottom: 16px; margin-bottom: 22px; }
  .logo { width: 48px; height: 48px; border-radius: 12px; background: #2C221E; color: #FDFBF7; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; }
  .institution { font-size: 22px; font-weight: 700; text-transform: uppercase; letter-spacing: -0.4px; }
  .subtitle { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: #D97706; margin-top: 2px; }
  .meta { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 20px; }
  .meta .label { color: #786C66; }
  .stat-row { display: flex; gap: 12px; margin-bottom: 22px; }
  .stat-card { flex: 1; background: #F5F2EB; border-radius: 14px; padding: 14px; text-align: center; }
  .stat-value { font-size: 24px; font-weight: 700; color: #2C221E; }
  .stat-label { font-size: 10px; color: #786C66; text-transform: uppercase; letter-spacing: 1px; margin-top: 3px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 24px; }
  th { background: #2C221E; color: #FDFBF7; text-align: left; padding: 8px 10px; font-weight: 600; }
  td { padding: 7px 10px; border-top: 1px solid #E6E1D5; }
  .delta-positive { color: #15803D; font-weight: 600; }
  .delta-negative { color: #B91C1C; font-weight: 600; }
  .guidance { background: #FAFAF7; border: 1px solid #E6E1D5; border-radius: 14px; padding: 16px 18px; }
  .guidance h3 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: #5C3D2E; }
  .guidance ul { margin: 0; padding-left: 18px; }
  .guidance li { margin-bottom: 6px; font-size: 12.5px; line-height: 1.4; }
  .footer { position: absolute; bottom: 14mm; right: 18mm; font-size: 10px; font-style: italic; color: #786C66; }
</style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="logo">R</div>
      <div>
        <div class="institution">{{institutionName}}</div>
        <div class="subtitle">Gelişim Karnesi</div>
      </div>
    </div>

    <div class="meta">
      <div><span class="label">Öğrenci: </span><strong>{{studentName}}</strong></div>
      <div><span class="label">Şube: </span><strong>{{branchName}}</strong></div>
      <div><span class="label">Dönem: </span><strong>{{periodLabel}}</strong></div>
    </div>

    <div class="stat-row">
      <div class="stat-card">
        <div class="stat-value">%{{attendanceRate}}</div>
        <div class="stat-label">Devam Oranı</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{subjectCount}}</div>
        <div class="stat-label">Değerlendirilen Branş</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Branş</th>
          <th>Öğrenci Neti</th>
          <th>Sınıf Ortalaması</th>
          <th>Fark</th>
        </tr>
      </thead>
      <tbody>
        {{#each subjectSummaries}}
        <tr>
          <td>{{this.subject}}</td>
          <td>{{this.studentNet}}</td>
          <td>{{this.classAverageNet}}</td>
          <td class="{{#if this.isPositive}}delta-positive{{else}}delta-negative{{/if}}">{{this.deltaLabel}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="guidance">
      <h3>Otomatik Rehberlik Değerlendirmesi</h3>
      <ul>
        {{#each guidanceNotes}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="footer">Powered by Routinix Kampüs</div>
  </div>
</body>
</html>

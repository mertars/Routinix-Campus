// Routinix Kampüs — K12 standartlarında veri modeli.
// Yerel geliştirme için: `docker compose up -d` ile Postgres'i ayağa kaldırıp
// `npm run db:migrate` çalıştırın (bkz. .env.example).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: bağlantı URL'si artık burada değil, prisma.config.ts +
// PrismaClient'a verilen 'adapter' üzerinden sağlanıyor (bkz. lib/server/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Ortak enum'lar
// ----------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum TransportMethod {
  SCHOOL_SERVICE
  PRIVATE_VEHICLE
  PUBLIC_TRANSPORT
  WALKING
}

enum ParentRelationship {
  MOTHER
  FATHER
  GUARDIAN
}

enum ConsentStatus {
  GRANTED
  DENIED
  PENDING
}

enum AdminAuthorityLevel {
  SUPER_ADMIN
  BRANCH_MANAGER
  COORDINATOR
}

// Öğrencinin/şubenin gerçek sınıf seviyesi kademesi — Yönetici panelindeki
// Genel/LGS/YKS/Mezun segment filtresinin tek gerçek kaynağı.
enum BranchSegment {
  LGS
  YKS
  MEZUN
}

// Tek kullanımlık şifre (OTP) amacı — ilk giriş aktivasyonu ve şifre sıfırlama
// akışlarında aynı OtpCode tablosu kullanılır; purpose ile birbirinden ayrılır.
enum OtpPurpose {
  FIRST_LOGIN
  PASSWORD_RESET
}

// ----------------------------------------------------------------------------
// Kurum yapısı
// ----------------------------------------------------------------------------

// Çoklu-kurum (SaaS) temeli — her "kök" kayıt (Branch/Student/Teacher/Admin/
// Parent/Exam/Announcement/NotificationBatch) bir Institution'a bağlıdır.
// isActive, statik JWT'ler için pratik tek iptal yoludur: bir kurumun
// erişimi anında kesilmek istendiğinde token'lar hâlâ geçerli olsa bile
// requireSession() burayı kontrol eder (bkz. lib/server/auth/session-guard.ts).
// Hiçbir kuruma AİT DEĞİL — platformun kendi sahibi/operatörü (bkz.
// scripts/create-platform-owner.ts, lib/server/auth/platform-jwt.ts).
// Institution.institutionId'li tüm modellerden BİLEREK ayrı tutulur: bu
// hesap türü kurum izolasyonunun DIŞINDA çalışır (yeni kurum + o kurumun
// ilk yöneticisini oluşturabilir), bu yüzden yetkisi dar tutulur — mevcut
// hiçbir kurumun öğrenci/not/veri kaydını OKUYAMAZ, sadece
// app/api/platform/* uçlarına (kurum oluşturma/listeleme) erişebilir.
model PlatformOwner {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Institution {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  isActive                    Boolean                      @default(true)
  // Kampüs V2 — çoklu modül (K12/ERP, Röntgen, Ölçme) platformuna geçiş:
  // kurumun kendi logosu (karne/PDF/üst bar gibi markalı yüzeylerde), SMS
  // gönderim kredisi bakiyesi ve kurumun kendi SMS sağlayıcı anahtarı
  // (dolarsa lib/server/sms/provider-factory.ts platform varsayılanı yerine
  // bunu kullanabilir — bkz. FAZ sonrası entegrasyon).
  logoUrl                     String?
  smsCredits                  Int                          @default(0)
  smsProviderKey              String?
  branches                    Branch[]
  students                    Student[]
  teachers                    Teacher[]
  admins                      Admin[]
  parents                     Parent[]
  exams                       Exam[]
  announcements               Announcement[]
  notificationBatches         NotificationBatch[]
  auditLogs                   AuditLog[]
  classrooms                  Classroom[]
  scheduleSlots               ScheduleSlotDefinition[]
  etutSetting                 EtutSetting?
  settings                    InstitutionSettings?
  institutionSmsTemplates     InstitutionSmsTemplate[]
  xrayMonthlyScreeningConfigs XrayMonthlyScreeningConfig[]
  videos                      Video[]
  opticalFormats              OpticalFormat[]
  examCategories              ExamCategory[]
  examGroups                  ExamGroup[]
  osymReferenceTables         OsymReferenceTable[]
  paymentAccounts             PaymentAccount[]
  installments                Installment[]
  payments                    Payment[]
  expenseCategories           ExpenseCategory[]
  expenses                    Expense[]
  contractTemplates           ContractTemplate[]
  studentContracts            StudentContract[]
  staffSalaryProfiles         StaffSalaryProfile[]
  payrollPeriods              PayrollPeriod[]
  staffAdvances               StaffAdvance[]
  products                    Product[]
  accountTransfers            AccountTransfer[]
  budgetLines                 BudgetLine[]
  studentDiscounts            StudentDiscount[]
  installmentAdjustments      InstallmentAdjustment[]
  paymentPromises             PaymentPromise[]
  enrollmentCancellations     EnrollmentCancellation[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

// Kurum geneli, tek-satırlık genel ayarlar — EtutSetting'in (sadece etüt
// süresi) YANINDA, ileride birikecek diğer genel bayraklar için TEK bir yer.
// isEtutAdminManaged: true iken etüt saatlerini SADECE yönetici belirler
// (öğretmen kendi TeacherEtutAvailability'sini giremez); false iken
// öğretmenler kendi müsaitliklerini kendileri yönetir (bkz. Kampüs V2 >
// Birebir Etüt modülü, ileriki bir PART'ta uygulanacak).
model InstitutionSettings {
  id                   String      @id @default(cuid())
  institutionId        String      @unique
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isEtutAdminManaged   Boolean     @default(true)
  // Deneme klasörlerinin varsayılan seti bu kuruma bir kez kuruldu mu?
  // Bayrak olmadan, kurum TÜM kategorileri bilerek silerse sistem onları
  // her istekte yeniden yaratırdı (bkz. ensureDefaultCategories).
  examCategoriesSeeded Boolean     @default(false)
  updatedAt            DateTime    @updatedAt
}

model Branch {
  id                    String                 @id @default(cuid())
  institutionId         String
  institution           Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name                  String // "12-A VIP" — kurum içinde benzersiz (bkz. @@unique altta)
  grade                 Int
  segment               BranchSegment          @default(YKS) // Mezun grubunun gerçek bir sınıf seviyesi yoktur (grade temsili tutulur)
  institutionalCode     String? // "RTX-IST01" — karne/QR gibi insan-okur yüzeylerde kullanılan kısa kod, kurum içinde benzersiz
  track                 String? // Alan/Dal: Sayısal, Eşit Ağırlık, Sözel, TM vb.
  advisorId             String?
  // SetNull (Cascade DEĞİL) — bir öğretmen tamamen silinince o şubenin
  // danışmansız kalması gerekir, ŞUBENİN KENDİSİ asla silinmemeli.
  advisor               Teacher?               @relation("BranchAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  // Danışman (advisor) TEK öğretmendir; bir şubede birden fazla branş
  // öğretmeni ders verebilir — bu çoka-çok ilişki o gerçek "kim nerede ders
  // veriyor" bilgisini taşır (öğretmen panelindeki assignedBranches kapsamı,
  // öğrenci etüt/rehberlik öğretmen seçicisi vb. buradan beslenir).
  teachingStaff         Teacher[]              @relation("BranchTeaching")
  students              Student[]
  quizzes               Quiz[]
  attendanceSubmissions AttendanceSubmission[]
  classbookNotes        ClassbookNote[]
  curriculumProgress    CurriculumProgress[]
  seatingArrangement    SeatingArrangement?
  materials             TeacherMaterial[]
  lessonSlots           LessonSlot[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([institutionId, name])
  @@unique([institutionId, institutionalCode])
  @@index([institutionId])
}

// ----------------------------------------------------------------------------
// Kullanıcı tipleri
// ----------------------------------------------------------------------------

model Student {
  id                           String                        @id @default(cuid())
  institutionId                String
  institution                  Institution                   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  nationalId                   String                        @unique // TC Kimlik No — v1 kararı: aynı kişi aynı anda iki kuruma kayıtlı olamaz (global benzersiz)
  firstName                    String
  lastName                     String
  birthDate                    DateTime?
  gender                       Gender?
  bloodType                    BloodType                     @default(UNKNOWN)
  studentNumber                String // Öğrenci No — kurum içinde benzersiz (bkz. @@unique altta)
  branchId                     String
  branch                       Branch                        @relation(fields: [branchId], references: [id])
  track                        String? // Alan/Dal (şube varsayılanını ezmek gerekirse)
  advisorTeacherId             String? // Danışman ID
  // SetNull (Cascade DEĞİL) — bir öğretmen tamamen silinince danışmanı
  // olduğu ÖĞRENCİ asla silinmemeli, sadece danışmansız kalır.
  advisorTeacher               Teacher?                      @relation("StudentAdvisor", fields: [advisorTeacherId], references: [id], onDelete: SetNull)
  transportMethod              TransportMethod?
  residenceAddress             String?
  email                        String?
  phone                        String?
  healthNote                   String? // Özel sağlık/alerji notu
  // Hedef net & haftalık çalışma saati — gerçek bir ölçüm/entegrasyon
  // kaynağı yok (Pomodoro cihazda kalır, bkz. gizlilik kuralı), bu yüzden
  // isteğe bağlı alanlar. targetNet, dashboard/xray/veli/karne gibi TÜM
  // mevcut tüketicilerin okuduğu TEK "toplam hedef net" alanı olmaya devam
  // eder — YKS öğrencisi TYT/AYT'yi ayrı ayrı girdiğinde (bkz. POST
  // /api/students/[id]/target-net) targetNet bu ikisinin toplamı olarak
  // otomatik güncellenir, mevcut tüketiciler dokunulmadan doğru kalır.
  targetNet                    Float?
  targetNetTyt                 Float?
  targetNetAyt                 Float?
  weeklyStudyHours             Int?
  passwordHash                 String? // bcrypt — kalıcı şifre hash'i (ilk girişe kadar null)
  mustChangePassword           Boolean                       @default(true) // ilk giriş / şifre değiştirme zorunluluğu
  // Yönetici "sil" dediğinde HARD DELETE yapılmaz — Student'a bağlı ~13 ayrı
  // ilişkide (ExamNetResult, AttendanceRecord, ReportCard, vb.) onDelete
  // tanımlı değil (Postgres varsayılanı fiilen RESTRICT), gerçek bir kayıt
  // geçmişi olan öğrenci silinmeye çalışılınca FK hatasıyla patlar — ve
  // "çalışsa bile" yıllarca birikmiş not/devamsızlık geçmişini geri
  // dönüşsüz siler. Bunun yerine pasifleştirilir: giriş engellenir, genel
  // listelerden düşer, geçmiş veri korunur.
  isActive                     Boolean                       @default(true)
  parents                      ParentStudent[]
  netResults                   ExamNetResult[]
  topicMasteryAssessments      TopicMasteryAssessment[]
  topicMasteryHistory          TopicMasteryHistory[]
  xrayMasteryGoals             XrayMasteryGoal[]
  xrayTestSessions             XrayTestSession[]
  xrayPracticeAttempts         XrayPracticeAttempt[]
  xrayComprehensionAssignments XrayComprehensionAssignment[]
  attendanceRecords            AttendanceRecord[]
  reportCards                  ReportCard[]
  reportCardShareLinks         ReportCardShareLink[]
  reportCardTeacherComments    ReportCardTeacherComment[]
  questions                    Question[]
  homeworkSubmissions          HomeworkSubmission[]
  quizSubmissions              QuizSubmission[]
  appointmentRequests          AppointmentRequest[]
  guidanceNotes                GuidanceNote[]
  guidanceReferrals            GuidanceReferral[]
  announcementReads            AnnouncementRead[]
  seatAssignments              ExamSeatAssignment[]
  preferences                  StudentPreference[]
  videoAssignments             VideoAssignment[]
  guidancePrograms             GuidanceProgram[]
  remediationTasks             RemediationTask[]
  alumniProfile                AlumniProfile?
  sentMentorRequests           MentorRequest[]               @relation("MentorRequestsSent")
  studyGoals                   StudyGoal[]
  installments                 Installment[]
  payments                     Payment[]
  contracts                    StudentContract[]
  discounts                    StudentDiscount[]
  installmentAdjustments       InstallmentAdjustment[]
  paymentPromises              PaymentPromise[]
  enrollmentCancellations      EnrollmentCancellation[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@unique([institutionId, studentNumber])
  @@index([branchId])
  @@index([institutionId])
}

model Parent {
  id                 String             @id @default(cuid())
  institutionId      String
  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  firstName          String
  lastName           String
  relationship       ParentRelationship
  mobilePhone        String // GSM (SMS onaylı)
  smsConsent         Boolean            @default(false)
  workPhone          String?
  email              String?
  homeAddress        String?
  workAddress        String?
  occupation         String?
  company            String?
  title              String?
  kvkkConsent        ConsentStatus      @default(PENDING)
  iysConsent         ConsentStatus      @default(PENDING)
  passwordHash       String? // bcrypt — kalıcı şifre hash'i (ilk girişe kadar null)
  mustChangePassword Boolean            @default(true) // ilk giriş / şifre değiştirme zorunluluğu
  students           ParentStudent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([institutionId])
}

// Öğrenci-Veli çoka-çok ilişkisi (bir öğrencinin birden fazla velisi, bir
// velinin birden fazla öğrencisi olabilir — kardeş kayıtları için gerekli).
model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id                      String                     @id @default(cuid())
  institutionId           String
  institution             Institution                @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  nationalId              String                     @unique // v1 kararı: aynı kişi aynı anda iki kuruma kayıtlı olamaz (global benzersiz)
  firstName               String
  lastName                String
  subject                 String // Branş
  university              String?
  mobilePhone             String
  institutionalEmail      String?
  personalEmail           String?
  dutyDays                String[] // Nöbet Günleri
  institutionalCode       String? // "TCH-102" — kısa, insan-okur öğretmen kodu (giriş kullanıcı adı DEĞİL — o T.C. No'dur), kurum içinde benzersiz
  passwordHash            String? // bcrypt — kalıcı şifre hash'i (ilk girişe kadar null)
  mustChangePassword      Boolean                    @default(true) // ilk giriş / şifre değiştirme zorunluluğu
  // bkz. Student.isActive'teki AYNI gerekçe (hard delete yerine pasifleştirme).
  isActive                Boolean                    @default(true)
  // Etüt Randevu Modülü: öğretmenin etütler arasına bırakmak istediği mola
  // süresi (dk) — bkz. lib/server/etut/compute-available-slots.ts. Aralık
  // bazında değil öğretmen bazında TEK bir değer (kullanıcı isteği).
  etutBreakMinutes        Int                        @default(10)
  advisorBranches         Branch[]                   @relation("BranchAdvisor")
  teachingBranches        Branch[]                   @relation("BranchTeaching")
  advisedStudents         Student[]                  @relation("StudentAdvisor")
  questions               Question[]
  homeworks               Homework[]
  quizzes                 Quiz[]
  quizBankQuestions       QuizBankQuestion[]
  attendanceSubmissions   AttendanceSubmission[]
  unavailability          TeacherUnavailability[]
  appointmentRequests     AppointmentRequest[]
  etutAvailability        TeacherEtutAvailability[]
  classbookNotes          ClassbookNote[]
  yearlyPlanRows          YearlyPlanRow[]
  materials               TeacherMaterial[]
  lessonSlots             LessonSlot[]
  dutySlots               TeacherDutySlot[]
  reportCardComments      ReportCardTeacherComment[]
  topicMasteryAssessments TopicMasteryAssessment[]
  salaryProfile           StaffSalaryProfile?
  payrollItems            PayrollItem[]
  staffAdvances           StaffAdvance[]
  guidanceReferrals       GuidanceReferral[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([institutionId, institutionalCode])
  @@index([institutionId])
}

// Tek kullanımlık şifre kaydı — telefon + amaç bazında en son geçerli kod
// tutulur. Kod düz metin saklanmaz; bcrypt hash'i tutulur (bkz. lib/server/auth/otp.ts).
model OtpCode {
  id         String     @id @default(cuid())
  phone      String // normalize edilmiş telefon (lib/server/auth/otp.ts > normalizePhone)
  purpose    OtpPurpose
  codeHash   String // bcrypt hash'li OTP
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

// Şifreli giriş (POST /api/auth/login) için brute-force kilidi — telefon
// bazında son başarısız deneme sayısı ve (varsa) kilit bitiş zamanı tutulur.
// OTP'nin kendi kod bazlı deneme sayacından (OtpCode.attempts) ayrıdır çünkü
// şifreli girişte "yeni kod iste" gibi doğal bir sıfırlama noktası yoktur.
model LoginAttempt {
  id          String    @id @default(cuid())
  phone       String    @unique
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Admin {
  id                           String                        @id @default(cuid())
  institutionId                String
  institution                  Institution                   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  firstName                    String
  lastName                     String
  title                        String
  authorityLevel               AdminAuthorityLevel           @default(BRANCH_MANAGER)
  institutionalMobile          String
  email                        String
  extensionNumber              String? // Dahili No
  passwordHash                 String? // bcrypt — kalıcı şifre hash'i (ilk girişe kadar null)
  mustChangePassword           Boolean                       @default(true) // ilk giriş / şifre değiştirme zorunluluğu
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  xrayComprehensionAssignments XrayComprehensionAssignment[]
  xrayPracticeAttempts         XrayPracticeAttempt[]
  xrayMonthlyScreeningConfigs  XrayMonthlyScreeningConfig[]
  videos                       Video[]
  recordedPayments             Payment[]
  recordedExpenses             Expense[]                     @relation("ExpenseRecordedBy")
  createdContracts             StudentContract[]             @relation("ContractCreatedBy")
  salaryProfile                StaffSalaryProfile?           @relation("AdminSalaryProfile")
  payrollItems                 PayrollItem[]                 @relation("AdminPayrollItem")
  staffAdvances                StaffAdvance[]                @relation("AdminStaffAdvance")
  recordedTransfers            AccountTransfer[]             @relation("TransferRecordedBy")
  approvedDiscounts            StudentDiscount[]             @relation("DiscountApprovedBy")
  voidedPayments               Payment[]                     @relation("PaymentVoidedBy")
  createdAdjustments           InstallmentAdjustment[]       @relation("AdjustmentCreatedBy")
  createdPromises              PaymentPromise[]              @relation("PromiseCreatedBy")
  createdCancellations         EnrollmentCancellation[]      @relation("CancellationCreatedBy")

  @@index([institutionId])
}

// ----------------------------------------------------------------------------
// Sınav / net verisi — karne motorunun beslendiği kaynak
// ----------------------------------------------------------------------------

model Exam {
  id              String               @id @default(cuid())
  institutionId   String
  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name            String
  examDate        DateTime
  // Klasör/kategori (2026-09-06) — denemeler düz bir liste olarak
  // birikince aranamaz hale geliyordu. Artık serbest metin DEĞİL, kuruma
  // ait yönetilebilir bir kayıt (bkz. ExamCategory): platform varsayılan
  // seti kurar (5-12. Sınıf, TYT, AYT, LGS, YKS), kurum yenisini ekleyip
  // istemediğini kaldırabilir. SetNull — kategori silinince denemeler
  // ASLA silinmez, "Kategorisiz"e düşer.
  categoryId      String?
  category        ExamCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // YKS eşleştirmesi — bir YKS denemesi aslında İKİ oturumdur (TYT + AYT).
  // İkisi aynı ExamGroup'a bağlanınca YKS sekmesinde tek bir deneme gibi
  // ele alınır, toplam net ikisinin toplamıdır (bkz. ExamGroup).
  groupId         String?
  group           ExamGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  results         ExamNetResult[]
  seatAssignments ExamSeatAssignment[]
  questions       ExamQuestion[]
  examSubjects    ExamSubject[]
  // "Yeni Deneme Oluştur" sihirbazı (2026-09-05) — bir sınav oluşturulurken
  // bir optik ŞABLONA (TYT/AYT Sayısal/… ya da "Farklı") bağlanabilir. Bağlıysa:
  // (a) o şablonun ders blokları OTOMATİK ExamSubject olarak eklenir,
  // (b) Optik Okuma adımında format seçimi ATLANIR (bu sınavınki hazır gelir).
  // SetNull: şablon silinirse geçmiş sınav etkilenmez, sadece bağı kopar.
  opticalFormatId String?
  opticalFormat   OpticalFormat?       @relation(fields: [opticalFormatId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([institutionId])
  @@index([institutionId, categoryId])
  @@index([groupId])
}

// Deneme klasörü. Platform her kuruma varsayılan seti bir kez kurar
// (bkz. lib/server/exams/categories.ts > ensureDefaultCategories); kurum
// sonrasında kendi kategorisini ekleyebilir ya da istemediğini
// kaldırabilir. Silme, içindeki denemeleri ETKİLEMEZ (Exam.categoryId
// SetNull) — sadece klasörden çıkarlar.
model ExamCategory {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  // Listede görünme sırası — sınıf seviyeleri ve sınav türleri anlamlı
  // bir sırada dursun diye (alfabetik sıralama "10. Sınıf"ı "5. Sınıf"ın
  // ÖNÜNE koyardı).
  sortOrder     Int              @default(0)
  kind          ExamCategoryKind @default(STANDARD)
  exams         Exam[]
  createdAt     DateTime         @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

// YKS_PAIR: bu klasör tekil denemeleri DEĞİL, TYT+AYT eşleşmelerini
// (ExamGroup) listeler — arayüz buna göre farklı render eder. Ada göre
// ("YKS" dizesi) ayırt etmek kırılgan olurdu (kurum adı değiştirebilir).
enum ExamCategoryKind {
  STANDARD
  YKS_PAIR
}

// Bir YKS denemesi = aynı organizasyonun TYT ve AYT oturumları. Optik
// dosyaları ayrı geldiği için ayrı Exam kayıtları olarak durur; bu grup
// onları tek bir "deneme" gibi ele almayı sağlar (toplam net = TYT + AYT).
model ExamGroup {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  examDate      DateTime
  exams         Exam[]
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

// ÖSYM Referans Tablosu (2026-09-06) — kullanıcı kararı: "ösym sıralama
// sistemini de kuralım". Resmi ÖSYM puanı ("ham puan katsayıları" o
// yılın TÜM Türkiye'deki adaylarının ortalama/standart sapmasına göre
// hesaplanır — bu istatistik ÖSYM'nin kendi verisidir, bizde YOK ve asla
// olamaz) kendimiz HESAPLAYAMAYIZ; bunu uydurmak yanıltıcı olurdu. Bunun
// yerine kurumun KENDİ elindeki (yayınevinden/ÖSYM'nin yıl sonu yayınladığı
// resmi istatistik raporundan) GERÇEK net→sıralama referans tablosunu
// buraya girmesini sağlıyoruz; karne bu tabloya göre ARA DEĞER (interpolasyon)
// ile "tahmini sıralama" gösterir — açıkça "kurum kaynaklı tahmin" etiketiyle.
model OsymReferenceTable {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "2025 TYT", "2025 AYT Sayısal" gibi
  // Bu tablo hangi puan türüne karşılık geliyor — "TYT" ya da alan adı
  // (bkz. track-mapping.ts > TRACK_NAMES: "Sayısal"/"Eşit Ağırlık"/"Sözel").
  puanTuru      String
  rows          OsymReferenceRow[]
  createdAt     DateTime           @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

model OsymReferenceRow {
  id      String             @id @default(cuid())
  tableId String
  table   OsymReferenceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  net     Float
  ranking Int

  @@index([tableId, net])
}

// Bu sınavda hangi derslerin ele alınacağının AÇIK listesi (2026-09-05
// Ölçme Değerlendirme sadeleştirmesi). Önceden "ders" kavramı SADECE
// ExamNetResult/ExamQuestion'da veri varsa var sayılıyordu — bu da
// sıfırdan bir sınavda "ders ekle" yapan bir yöneticinin, henüz hiçbir
// cevap anahtarı/net kaydetmeden sayfadan çıkıp geri dönünce eklediği
// dersin sessizce KAYBOLMASINA yol açıyordu (kafa karıştırıcıydı). Şimdi
// bir ders EKLENDİĞİ anda burada kalıcı bir satır olarak saklanıyor.
model ExamSubject {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   String
  createdAt DateTime @default(now())

  @@unique([examId, subject])
  @@index([examId])
}

model ExamNetResult {
  id                   String   @id @default(cuid())
  examId               String
  exam                 Exam     @relation(fields: [examId], references: [id])
  studentId            String
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject              String // "Matematik"
  net                  Float
  // Kazanım bazlı deneme analizi (2026-09-05) — bu dersin cevap anahtarı
  // (bkz. ExamQuestion) tanımlıysa, bu iki dizi + ExamQuestion'daki soru→
  // kazanım eşlemesi kullanılarak konu bazlı doğru/yanlış/boş kırılımı
  // hesaplanır (bkz. lib/server/exams/subtopic-breakdown.ts). Soru NUMARASI
  // saklanıyor (soru metni/cevabı değil) — dershanenin kağıt üzerindeki
  // optik/cevap kâğıdıyla BİREBİR aynı numaralandırma varsayılıyor.
  wrongQuestionNumbers Int[]    @default([])
  blankQuestionNumbers Int[]    @default([])
  // Optik okumadan gelen HAM cevap dizisi (2026-09-06) — her karakter bir
  // soru numarasının öğrencinin İŞARETLEDİĞİ şıkkı (A-E; boş/geçersizse
  // orijinal karakter neyse o, örn. " " ya da "0"). Kullanıcı kararı:
  // "yanlış şıkkı da alsın sistem, sonuçta sisteme girdi veriliyor" —
  // optik dosyası zaten bunu taşıyor, sadece puanlamadan sonra ATILIYORDU.
  // SADECE optik yüklemeden gelir; elle girilen (yanlış/boş soru NUMARASI)
  // sonuçlarda null kalır — KONU ANALİZİ'nde ÖC sütunu o durumda boş kalır.
  answerLetters        String?
  createdAt            DateTime @default(now())

  @@unique([examId, studentId, subject])
  @@index([studentId])
}

// Kazanım bazlı deneme analizi (2026-09-05) — bir sınavın BİR dersi için
// "cevap anahtarı": her soru numarasının hangi konuya/kazanıma ait olduğu.
// subtopicId DOLUYSA (CURRICULUM_TREE'deki gerçek bir subtopic.id) bu soru
// Röntgen köprüsüne (TopicMasteryAssessment, source=PAPER_EXAM) dahil
// edilir — CURRICULUM_TREE sadece Matematik/Fizik için gerçek kırılıma
// sahip olduğundan diğer derslerde subtopicId boş kalır, sadece
// subtopicLabel (serbest metin) ile bu sınava özel analiz/karne
// gösteriminde kullanılır (Röntgen'i beslemez, ama yine de "hangi
// konudan kaç net" bilgisini karnede göstermeye yeter).
model ExamQuestion {
  id             String  @id @default(cuid())
  examId         String
  exam           Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        String
  questionNumber Int
  subtopicId     String? // CURRICULUM_TREE içindeki subtopic.id (varsa)
  subtopicLabel  String // her zaman dolu — gösterim için (subtopicId varsa CURRICULUM_TREE'deki adıyla AYNI tutulmalı)
  // Optik okuma köprüsü (2026-09-05) — bu sorunun doğru şıkkı (A-E). Elle
  // girilen sınavlarda boş kalabilir (o zaman sadece kazanım analizi
  // çalışır, optik yükleme çalışmaz); optik dosyası yüklemek için ZORUNLU
  // (bkz. lib/server/exams/optical-import.ts > scoreOpticalAnswers).
  correctAnswer  String?

  @@unique([examId, subject, questionNumber])
  @@index([examId, subject])
}

// Optik (OMR tarayıcı) sabit-genişlikli metin dosyası formatı tanımı —
// gerçek piyasa optik tarayıcıları BİR GÖRÜNTÜ değil, her satırı bir
// öğrenci olan sabit-genişlikli bir .txt üretir (T.C./ad-soyad/şube sabit
// karakter aralıklarında, sonra ders başına işaretlenen şıkların (A-E)
// tek harflik dizisi). Farklı tarayıcı/kurum farklı sütun düzeni
// kullanabildiği için bu düzen kurum bazında YAPILANDIRILABİLİR (bkz.
// components/olcme/optical-format-manager.tsx) — tek bir sınava değil,
// kuruma ait, birden çok sınavda tekrar kullanılır.
model OpticalFormat {
  id              String                @id @default(cuid())
  institutionId   String
  institution     Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String
  // Kimlik alanları — hepsi opsiyonel (bazı formatlarda olmayabilir) DIŞINDA
  // adı soyadı (eşleştirme için en az biri: T.C. ya da ad-soyad ZORUNLU,
  // uygulama katmanında doğrulanır).
  tcNoStart       Int?
  tcNoLength      Int?
  studentNoStart  Int?
  studentNoLength Int?
  bookletStart    Int?
  bookletLength   Int?
  gradeStart      Int?
  gradeLength     Int?
  branchStart     Int?
  branchLength    Int?
  nameStart       Int?
  nameLength      Int?
  subjectBlocks   OpticalSubjectBlock[]
  exams           Exam[]
  createdAt       DateTime              @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

// Bir optik formatının HER dersi kendi sabit sütun aralığında taşır (satırın
// o aralığındaki her karakter = o dersin bir sorusunun işaretlenen şıkkı,
// bu yüzden length = o dersteki soru sayısı). `order`: gerçek dosyadaki
// FİZİKSEL sırası (2026-09-05 sihirbazı bunu hem gösterim hem "bir
// sonraki dersin başlangıcı otomatik önerilsin" hesaplaması için kullanır).
model OpticalSubjectBlock {
  id       String        @id @default(cuid())
  formatId String
  format   OpticalFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)
  subject  String
  order    Int           @default(0)
  start    Int
  length   Int

  @@unique([formatId, subject])
}

// Kampüs V2 Part 4 — Gelişmiş Yoklama Matrisi: bir satır artık bir GÜNÜ
// değil, o günün TEK bir DERSİNİ (slot) temsil eder — aynı öğrenci aynı gün
// içinde birden fazla derse (birden fazla satır) sahip olabilir. slot/subject
// BİLEREK denormalize edilmiş (LessonSlot'a canlı join yerine yazıldığı anki
// değer saklanır) — ders programı sonradan değişse/silinse bile geçmiş bir
// yoklama kaydının "hangi ders" olduğu bilgisi kaybolmaz (bkz. NotificationLog'daki
// AYNI gerekçe). "Günlük Devamsızlık" (kaç FARKLI gün) ile "Ders Devamsızlığı"
// (kaç ayrı ders saati) BİLEREK bu TEK tablodan iki farklı aggregation ile
// hesaplanır — ayrı bir "günlük özet" tablosu YOK (bkz.
// lib/server/attendance/absence-summary.ts).
model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  slot      String   @default("") // "HH:MM-HH:MM" — LessonSlot.slot ile aynı format/değer
  subject   String   @default("Genel")
  status    String // PRESENT | ABSENT | LATE
  createdAt DateTime @default(now())

  @@unique([studentId, date, slot])
}

// Bir öğretmenin belirli bir şube+tarih için yoklamayı "gönderdiği" olayın
// hafif denetim kaydı — AttendanceRecord'lar (öğrenci bazlı) zaten asıl veri,
// bu sadece "kim, ne zaman, kaç öğrenci için gönderdi" akışını (yönetici
// panelindeki canlı bildirim listesi) beslemek içindir.
model AttendanceSubmission {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  date        DateTime
  recordCount Int
  createdAt   DateTime @default(now())

  @@index([branchId])
}

// ----------------------------------------------------------------------------
// Toplu Bildirim / SMS
// ----------------------------------------------------------------------------

enum NotificationScopeType {
  ALL_SCHOOL // TumOkul
  GRADE // Kademe (örn. 12. Sınıflar)
  BRANCH // Sube (örn. 12-A VIP)
  CUSTOM_GROUP // OzelGrup
  CUSTOM_ID_LIST // CustomIDList
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model SmsTemplate {
  id        String              @id @default(cuid())
  key       String              @unique // "devamsizlik_bildirimi"
  label     String
  body      String // "Sayın {veli_adi}, öğrencimiz {ogrenci_adi} ..."
  batches   NotificationBatch[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ⚠️ İSİMLENDİRME NOTU: Kampüs V2 isteğinde "SmsTemplate" adıyla istenen
// model — YUKARIDAKİ SmsTemplate zaten dolu ve FARKLI bir amaca hizmet
// ediyor (key bazlı, TÜM kurumlar arasında paylaşılan, NotificationBatch'e
// bağlı sabit sistem şablonları — "devamsizlik_bildirimi" gibi). İstenen
// alan kümesi (institutionId, title, content) ise kurumun KENDİ serbest
// metin SMS şablonlarını tutuyor; bu yüzden ayrı bir model olarak
// InstitutionSmsTemplate adıyla eklendi — mevcut sistem şablonlarıyla
// KARIŞTIRILMAMALI, henüz hiçbir API/UI bu modele bağlı değil.
model InstitutionSmsTemplate {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  content       String
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

model NotificationBatch {
  id            String                @id @default(cuid())
  institutionId String
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  scopeType     NotificationScopeType
  scopeValue    String? // "12" (Kademe), "12-A VIP" (Şube), "id1,id2" (CustomIDList) vb.
  templateId    String?
  template      SmsTemplate?          @relation(fields: [templateId], references: [id])
  rawMessage    String?
  logs          NotificationLog[]
  createdAt     DateTime              @default(now())

  @@index([institutionId])
}

model NotificationLog {
  id             String             @id @default(cuid())
  batchId        String
  batch          NotificationBatch  @relation(fields: [batchId], references: [id])
  recipientPhone String
  recipientName  String?
  message        String
  status         NotificationStatus @default(PENDING)
  providerName   String?
  providerRef    String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([batchId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Soru Sor & Soru Havuzu — öğrencinin çözemediği bir sorunun fotoğrafını
// seçtiği öğretmene ilettiği, öğretmenin yanıtladığı akış.
// ----------------------------------------------------------------------------

enum QuestionStatus {
  PENDING // Öğretmene ulaştı, henüz yanıtlanmadı
  ANSWERED // Öğretmen yazılı/sesli yanıt verdi
  SOLVED // Öğrenci "anladım" olarak işaretledi
}

model Question {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  // ⚠️ Cascade — Question.teacherId NOT NULL olduğundan SetNull mümkün
  // değil; öğretmen tamamen silindiğinde ona yöneltilmiş sorular da gider
  // (bkz. "tamamen sil" özelliğinin genel gerekçesi, Student için de aynı).
  teacher     Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     String // Ders/Branş adı — öğretmenin branşından bağımsız olarak öğrencinin seçtiği ders
  imageUrl    String // Yüklenen soru fotoğrafının yolu (bkz. lib/server/uploads)
  studentNote String? // "3. adımı anlamadım" vb.
  status      QuestionStatus @default(PENDING)
  answerText  String?
  answeredAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Akıllı Ödev Masası & Teslim Portalı
// ----------------------------------------------------------------------------

enum HomeworkStatus {
  NOT_DONE
  HALF
  DONE
  LATE
}

model Homework {
  id                  String               @id @default(cuid())
  teacherId           String
  teacher             Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchIds           String[] // aynı ödev birden fazla şubeye atanabilir
  title               String
  description         String?
  linkUrl             String?
  fileNames           String[] // yüklenen ek dosya adları (görüntüleme amaçlı)
  checklist           String[]
  targetQuestionCount Int?
  dueAt               DateTime?
  createdAt           DateTime             @default(now())
  submissions         HomeworkSubmission[]

  @@index([teacherId])
}

model HomeworkSubmission {
  id         String         @id @default(cuid())
  homeworkId String
  homework   Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     HomeworkStatus @default(NOT_DONE)
  updatedAt  DateTime       @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Pop-Quiz & Anlık Soru Fırlatma
// ----------------------------------------------------------------------------

enum QuizStage {
  LIVE
  ENDED
}

model Quiz {
  id              String           @id @default(cuid())
  teacherId       String
  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  name            String
  durationSeconds Int
  stage           QuizStage        @default(LIVE)
  launchedAt      DateTime         @default(now())
  endedAt         DateTime?
  questions       QuizQuestion[]
  submissions     QuizSubmission[]

  @@index([teacherId])
  @@index([stage])
}

model QuizQuestion {
  id         String @id @default(cuid())
  quizId     String
  quiz       Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  imageLabel String
  answer     String
  position   Int
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  correct     Int
  wrong       Int
  submittedAt DateTime @default(now())

  @@unique([quizId, studentId])
}

// Öğretmenin daha önce kullandığı Pop-Quiz sorularının tekrar kullanılabilir
// havuzu (bir quiz bitince oradaki sorular buraya da eklenir).
model QuizBankQuestion {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  imageLabel String
  answer     String
  addedAt    DateTime @default(now())

  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// Birebir Etüt & Randevu Sistemi
// ----------------------------------------------------------------------------

// Öğretmenin haftalık programında etüt ALAMAYACAĞI (bloke ettiği) saatler —
// bunun dışındaki her saat, o an başka bir randevuyla dolu olmadığı sürece
// müsaittir. Onaylanmış AppointmentRequest kayıtları zaten "dolu" saatleri
// temsil ettiği için ayrı bir "EtutSlot" tablosuna gerek yok.
model TeacherUnavailability {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day       String // "Pazartesi".."Cuma"
  slot      String // "16:00-17:00" vb.

  @@unique([teacherId, day, slot])
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// AppointmentRequest'in day/slot alanları (String, "HH:MM-HH:MM") Etüt Randevu
// Modülü'nün DİNAMİK olarak hesapladığı slot etiketleriyle birebir uyumlu —
// bu yüzden booking modeli olarak AYNEN korunuyor, yeni bir "EtutAppointment"
// modeline gerek yok (bkz. lib/server/etut/compute-available-slots.ts).
// status PENDING veya APPROVED olan HER kayıt, mola tamponuyla birlikte
// slotu "dolu" sayar — bir öğrenci talep GÖNDERDİĞİ anda (öğretmen henüz
// onaylamadan) o saat başka bir öğrenciye teklif edilmez.
model AppointmentRequest {
  id          String            @id @default(cuid())
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topic       String
  day         String
  slot        String
  status      AppointmentStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  decidedAt   DateTime?

  @@index([teacherId])
  @@index([studentId])
}

// Kurum geneli etüt süresi (dk) — Yönetici panelinden ayarlanır, varsayılan
// 20. Kayıt yoksa (yeni kurum onboarding'i unutursa) API tarafı 20'yi
// varsayılan kabul eder (bkz. lib/server/etut/compute-available-slots.ts).
model EtutSetting {
  id              String      @id @default(cuid())
  institutionId   String      @unique
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  durationMinutes Int         @default(20)
  updatedAt       DateTime    @updatedAt
}

// Öğretmenin etüt için müsait olduğu SERBEST aralıklar — TeacherUnavailability
// (ders programı atama çakışma kontrolü için kullanılan, ayrı ve dokunulmamış
// bir model) ile KARIŞTIRILMAMALI. Bir öğretmen aynı gün için birden fazla
// aralık girebilir (ör. Pazartesi 12:00-14:00 VE 15:00-16:30) — iki ayrı satır.
model TeacherEtutAvailability {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day       String // "Pazartesi".."Cuma"
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  createdAt DateTime @default(now())

  @@index([teacherId, day])
}

// ----------------------------------------------------------------------------
// Rehberlik & PDR Modülü
// ----------------------------------------------------------------------------

enum GuidanceCategory {
  ACADEMIC
  PSYCHOLOGICAL
  DISCIPLINARY
}

// PUBLIC: sevk eden öğretmen + yönetici görebilir (yönetici akışında görünür)
// RESTRICTED: sadece yönetici + rehberlik (yönetici akışında görünür, içerik özetlenir)
// CONFIDENTIAL: sadece rehberlik erişebilir (yönetici canlı akışında HİÇ görünmez)
enum ConfidentialityLevel {
  PUBLIC
  RESTRICTED
  CONFIDENTIAL
}

model GuidanceNote {
  id                   String               @id @default(cuid())
  studentId            String
  student              Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorName           String
  category             GuidanceCategory     @default(ACADEMIC)
  confidentialityLevel ConfidentialityLevel @default(RESTRICTED)
  note                 String
  createdAt            DateTime             @default(now())

  @@index([studentId])
}

enum GuidanceReferralStatus {
  PENDING
  REVIEWED
}

// Bir öğretmenin bir öğrenciyi rehberliğe SEVK ETME olayının kendisi —
// GuidanceNote'tan (serbest metin not) BİLEREK ayrı: burada asıl bilgi
// sabit bir "not" değil, TAKİP EDİLEBİLİR bir durumdur (PENDING/REVIEWED).
// ⚠️ components/teacher/tabs/risk-referral.tsx'teki mevcut "Rehberliğe Sevk
// Et" butonu HENÜZ bu modele değil, sabit metinli bir GuidanceNote'a
// yazıyor — bu model sadece şema düzeyinde eklendi, o akışın buraya
// taşınması (ve rehberlik tarafında PENDING/REVIEWED kuyruğu göstermesi)
// ayrı bir PART'ta yapılacak.
model GuidanceReferral {
  id        String                 @id @default(cuid())
  studentId String
  student   Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reason    String
  status    GuidanceReferralStatus @default(PENDING)
  createdAt DateTime               @default(now())

  @@index([studentId])
  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// Duyuru, Etkinlik & Acil Bildirim Akışı
// ----------------------------------------------------------------------------

enum AnnouncementCategory {
  GENERAL
  EXAM
  HOLIDAY
  EVENT
  EMERGENCY
}

enum AnnouncementAuthorRole {
  ADMIN
  TEACHER
}

model Announcement {
  id            String                 @id @default(cuid())
  institutionId String
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  title         String
  content       String
  category      AnnouncementCategory   @default(GENERAL)
  // Hedef kitle: NotificationScopeType, SMS modülüyle aynı — ALL_SCHOOL /
  // GRADE (scopeValue: "12") / BRANCH (scopeValue: branchId) burada kullanılır.
  scopeType     NotificationScopeType  @default(ALL_SCHOOL)
  scopeValue    String?
  authorName    String
  authorRole    AnnouncementAuthorRole
  createdAt     DateTime               @default(now())
  reads         AnnouncementRead[]

  @@index([institutionId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, studentId])
}

// ----------------------------------------------------------------------------
// Gelişim Karnesi üretim kaydı (audit)
// ----------------------------------------------------------------------------

model ReportCard {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodLabel String // "2025-2026 1. Dönem"
  generatedAt DateTime @default(now())

  @@index([studentId])
}

// Oturum açmadan (token bazlı, süreli) karne PDF'ine erişim — veli/öğrenci
// karneyi WhatsApp/SMS ile PAYLAŞABİLSİN diye. Token, karneyi zaten
// görüntüleme yetkisi olan biri (öğrenci/danışman-branş öğretmeni/veli/
// yönetici — bkz. GET /api/report-cards/[studentId]'teki aynı sahiplik
// kuralı) tarafından üretilir; süresi dolunca (varsayılan 7 gün) geçersiz
// olur, kalıcı bir "herkese açık" link DEĞİLDİR.
model ReportCardShareLink {
  id          String   @id @default(cuid())
  token       String   @unique
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodLabel String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([studentId])
}

// Danışman/branş öğretmeninin karneye eklediği SERBEST METİN yorum —
// analyzer.ts'teki kural-bazlı otomatik rehberlik notlarından BİLEREK
// ayrı (o notlar hep aynı sabit eşiklerden üretilir, bu ise öğretmenin
// KENDİ gözlemi). Dönem başına TEK yorum (öğretmen istediği zaman
// günceller) — bu yüzden studentId+periodLabel benzersiz.
model ReportCardTeacherComment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodLabel String
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  comment     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, periodLabel])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Dijital Sınıf Defteri & Yıllık Plan
// ----------------------------------------------------------------------------

model ClassbookNote {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@index([branchId])
}

model YearlyPlanRow {
  id           String   @id @default(cuid())
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekLabel    String
  subtopicName String
  notes        String?
  createdAt    DateTime @default(now())

  @@index([teacherId])
}

// Müfredat konu ağacının kendisi (CURRICULUM_TREE) statik referans içerik
// olarak lib/mock-data.ts'te kalır — MEB müfredatı, kurumun düzenlediği bir
// veri değil. Burada sadece "hangi şube hangi alt konuyu işledi" durumu
// (şubeye göre gerçek, kalıcı ilerleme) tutulur.
model CurriculumProgress {
  id         String    @id @default(cuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  subject    String
  subtopicId String // CURRICULUM_TREE içindeki subtopic.id
  covered    Boolean   @default(false)
  coveredAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([branchId, subtopicId])
  @@index([branchId])
}

// ----------------------------------------------------------------------------
// Oturma Planı & Öğrenci Çarkı — roster gerçek Student tablosundan gelir,
// burada sadece o şube için mevcut koltuk SIRASI tutulur.
// ----------------------------------------------------------------------------

model SeatingArrangement {
  id           String   @id @default(cuid())
  branchId     String   @unique
  branch       Branch   @relation(fields: [branchId], references: [id])
  studentOrder String[] // Student.id sıralı listesi
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Ders Materyali Kütüphanesi
// ----------------------------------------------------------------------------

model TeacherMaterial {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  title     String
  fileUrl   String
  fileType  String // pdf | doc | slide
  sizeLabel String
  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// Kelebek Sınav Oturma Planı — mevcut Exam kaydına bağlı, kalıcı koltuk
// atamaları (öğrenci + öğretmen + yönetici aynı gerçek veriyi görür).
// ----------------------------------------------------------------------------

// Şubeden BAĞIMSIZ fiziksel sınav odası — yönetici serbestçe adlandırır ve
// kroki (desk yerleşimi) tasarlar. `layout`, x/y serbest konumlu masaların
// JSON dizisidir (sabit satır/sütun ızgarası DEĞİL — U-düzeni gibi keyfi
// yerleşimlere izin vermek için, bkz. lib/server/seating/types.ts).
model Classroom {
  id              String               @id @default(cuid())
  institutionId   String
  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name            String
  layout          Json
  seatAssignments ExamSeatAssignment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId])
}

model ExamSeatAssignment {
  id          String     @id @default(cuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id])
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // classroomId nullable — eski (Sınıf kavramından ÖNceki) kayıtlar sadece
  // hall serbest metnine sahip, geriye dönük bozulmasın diye zorunlu
  // yapılmadı. ⚠️ Prisma, OPSİYONEL ilişkilerde onDelete belirtilmezse
  // varsayılan olarak SetNull uygular (RESTRICT DEĞİL — bu, FAZ 1'de
  // yanlış varsayılmıştı, 0_init migration'ında zaten SetNull olduğu
  // görülünce fark edildi). Burada AÇIKÇA Restrict isteniyor — geçmiş
  // sınav oturma kaydı olan bir Sınıf sessizce "unutulmasın", silinmek
  // istenirse önce o geçmiş taşınmalı/temizlenmeli.
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  deskId      String? // layout içindeki Desk.id — hangi masada oturduğu (komşuluk denetimi/ileri kroki görünümü için)
  hall        String
  seatNumber  Int
  rowNum      Int
  colNum      Int
  createdAt   DateTime   @default(now())

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([classroomId])
}

// ----------------------------------------------------------------------------
// YKS/LGS Tercih Robotu — üniversite/bölüm referans listesi (UNIVERSITY_PROGRAMS,
// temsili taban sıralamalarıyla) statik içerik olarak mock-data.ts'te kalır;
// burada sadece öğrencinin kaydettiği GERÇEK tercih sırası tutulur.
// ----------------------------------------------------------------------------

model StudentPreference {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String // UNIVERSITY_PROGRAMS içindeki program.id
  position  Int
  createdAt DateTime @default(now())

  @@unique([studentId, programId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Çakışmasız Ders Programı — yöneticinin sürükle-bırak ile oluşturduğu ana
// haftalık program; öğretmen ve öğrenci panelindeki "Haftalık Program"
// sekmeleri BUNUN salt-okunur, kendi kapsamına göre süzülmüş görünümleridir
// (teacherId / branchId'ye göre filtrelenir).
// ----------------------------------------------------------------------------

model LessonSlot {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   String
  day       String // "Pazartesi".."Cuma"
  slot      String // "16:00-17:00" vb.

  @@unique([branchId, day, slot])
  @@index([teacherId])
}

// Kurumun ders programı ekranında kullandığı saat dilimi ETİKETLERİ
// ("16:00-17:00" gibi) — önceden sabit 4 saatlik bir listeye (SCHEDULE_SLOTS,
// lib/mock-data.ts) kilitliydi, artık yönetici kendi kurumunun gerçek
// çalışma saatlerine göre ekleyip/silip/yeniden adlandırabiliyor.
// LessonSlot.slot/TeacherDutySlot.slot ile GERÇEK bir FK ilişkisi YOK
// (o alanlar serbest metin) — silme/yeniden adlandırma sırasındaki
// tutarlılık uygulama katmanında sağlanır (bkz. lib/server/admin/schedule-slots.ts).
// label "HH:MM-HH:MM" formatında OLMALI — lib/schedule-time.ts > parseSlotRange
// bu formatı varsayarak "şu an hangi ders" gibi zaman karşılaştırmaları yapar.
model ScheduleSlotDefinition {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  label         String
  createdAt     DateTime    @default(now())

  @@unique([institutionId, label])
  @@index([institutionId])
}

model TeacherDutySlot {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day       String
  slot      String
  label     String

  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// Rehberlik & PDR A4 Kişisel Çalışma Programı — rehberlik biriminin öğrenci
// için hazırlayıp portala gönderdiği haftalık program + geçmişi.
// ----------------------------------------------------------------------------

model GuidanceProgram {
  id        String                 @id @default(cuid())
  studentId String
  student   Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekLabel String
  createdAt DateTime               @default(now())
  entries   GuidanceProgramEntry[]

  @@index([studentId])
}

model GuidanceProgramEntry {
  id             String          @id @default(cuid())
  programId      String
  program        GuidanceProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  day            String
  time           String
  subject        String
  topic          String
  questionTarget Int
}

// ----------------------------------------------------------------------------
// Eksik Kapatma — öğretmenin bir öğrenciye atadığı telafi görevi.
// ----------------------------------------------------------------------------

model RemediationTask {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic           String
  taskDescription String
  assignedAt      DateTime @default(now())

  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Audit Log — kritik yazma işlemlerinin (kullanıcı oluşturma, not girişi,
// rehberlik notu, şifre değişimi) kim/ne-zaman/ne kaydı. Sadece EKLENİR,
// hiçbir zaman güncellenmez/silinmez — bu yüzden updatedAt yok.
// ----------------------------------------------------------------------------

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  GRADE_ENTERED
  GUIDANCE_NOTE_CREATED
  GUIDANCE_REFERRAL_CREATED
  PASSWORD_CHANGED
  BRANCH_CREATED
  PASSWORD_RESET_BY_ADMIN
  USER_DEACTIVATED
  USER_DELETED_PERMANENTLY
  CLASSROOM_CREATED
  ALUMNI_PROFILE_CREATED
  HOMEWORK_SUBMITTED
}

model AuditLog {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  // actorId'nin FK'si YOK — Admin/Teacher/Student/Parent'tan (4 farklı tablo)
  // herhangi biri olabilir; Prisma polimorfik ilişkiyi desteklemiyor, bu
  // yüzden actorRole ile birlikte denormalize tutulur (AuthRole değeri).
  actorId       String
  actorRole     String
  action        AuditAction
  targetType    String
  targetId      String
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// ----------------------------------------------------------------------------
// Mezun Gurur Tablosu & Mentorluk — önceden tamamen mock veriydi (ALUMNI,
// lib/mock-data.ts). "Mezun" burada AYRI bir kişi kaydı DEĞİL — kurumda
// GERÇEKTEN kayıtlı olmuş bir Student'a bağlı, mezuniyet SONRASI bilgileri
// (üniversite, mentorluk durumu vb.) tutan bir PROFİL. Student kaydı
// silinirse (kalıcı silme) bu profil de anlamsız kalır, bu yüzden Cascade.
// ----------------------------------------------------------------------------

model AlumniProfile {
  id             String          @id @default(cuid())
  studentId      String          @unique
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  graduationYear Int
  highSchoolRank String? // "Kurum 1.si" gibi — isteğe bağlı, gurur tablosunda rozet olarak gösterilir
  admittedTo     String // "Boğaziçi Üniversitesi — Bilgisayar Mühendisliği"
  examScope      String // "YKS" | "LGS"
  isMentor       Boolean         @default(false)
  mentorNote     String? // mezunun kendi sözleriyle, ne konuda destek verdiği
  // Mentorluk onaylandığında öğrenciye/veliye gösterilecek iletişim bilgisi
  // — Student.phone'dan BİLEREK ayrı: mezun, okuldaki kaydından FARKLI
  // (güncel) bir numara vermek isteyebilir.
  contactPhone   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mentorRequests MentorRequest[]

  @@index([studentId])
}

// Bir öğrencinin bir mezun-mentora gönderdiği destek talebi. Mezunun kendisi
// sisteme giriş yapmıyor (hesabı zaten deaktive/silinmiş olabilir) — bu
// yüzden onay akışı yönetici/rehberlik üzerinden yürür: yönetici mezunla
// OKUL DIŞI bir kanaldan (telefon, WhatsApp) iletişime geçip onaylar,
// onaylanınca AlumniProfile.contactPhone talep eden öğrenciye açılır.
model MentorRequest {
  id                 String        @id @default(cuid())
  alumniProfileId    String
  alumniProfile      AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  requesterStudentId String
  requesterStudent   Student       @relation("MentorRequestsSent", fields: [requesterStudentId], references: [id], onDelete: Cascade)
  message            String?
  status             String        @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?

  @@index([alumniProfileId])
  @@index([requesterStudentId])
}

// Pomodoro & Hedef Yönetimi — GİZLİLİK KURALI KORUNDU: bu iki model SADECE
// öğrencinin kendi API uçlarından (assertOwnsSelf) erişilebilir, hiçbir
// öğretmen/yönetici/veli ucu bu veriyi OKUMAZ (bkz. components/student/tabs/
// pomodoro.tsx'teki mevcut gizlilik notu — önceden tarayıcı localStorage'ında
// tutulan bu veri artık kalıcı/geçmişli olması için DB'ye taşındı, ama
// "kimseye görünmez" ilkesi API erişim kontrolünde AYNEN sürdürülüyor).
//
// Bir öğrencinin TEK bir aktif (isCompleted=false) genel hedefi olabilir —
// yeni bir hedef belirlendiğinde eskisi otomatik tamamlanıp "Geçmiş
// Hedeflerim"e düşer (bkz. app/api/study-goals/route.ts).
model StudyGoal {
  id                String           @id @default(cuid())
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetQuestions   Int?
  targetMinutes     Int?
  progressQuestions Int              @default(0)
  progressMinutes   Int              @default(0)
  isCompleted       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  completedAt       DateTime?
  topicGoals        StudyTopicGoal[]

  @@index([studentId, isCompleted])
}

// Genel hedefin altına eklenen özel konu/görev hedefi (ör. "Trigonometri —
// 30 Dakika — 20 Soru", açıklama: "Çıkmış sorular çözülecek").
model StudyTopicGoal {
  id                String    @id @default(cuid())
  studyGoalId       String
  studyGoal         StudyGoal @relation(fields: [studyGoalId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  targetMinutes     Int?
  targetQuestions   Int?
  progressMinutes   Int       @default(0)
  progressQuestions Int       @default(0)
  isCompleted       Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([studyGoalId])
}

// ----------------------------------------------------------------------------
// Akademik Röntgen (Hub'daki 2. modül, Kampüs V2 Part 6) — Faz 1-2
// ----------------------------------------------------------------------------
//
// Faz 2 revizyonu: masteryScore artık bir öğretmenin ELLE girdiği bir puan
// DEĞİL — öğrencinin gerçekten çözdüğü, konu bazlı ADAPTİF bir tanı
// testinden (bkz. XrayTestSession/XrayTestAnswer) otomatik hesaplanıyor.
// "Matematik Röntgeni" ürününün gerçek mekaniği budur: kolay soruyu çözen
// öğrenciye o konuda zorlaşan sorular gelir, çözemeyene o konuda daha fazla
// soru gösterilmez (bkz. lib/server/xray/adaptive-engine.ts). Soru
// HAVUZUNUN (XrayQuestion) içeriği şu an ELLE yazılmış az sayıda placeholder
// sorudan ibarettir — gerçek içerik büyük ihtimalle yapay zeka ile
// üretilecek, ama bu ŞEMA o zaman DEĞİŞMEYECEK, sadece INSERT eden taraf
// (elle/script yerine bir AI üretim job'ı) değişecek.

// Faz D: TopicMasteryAssessment artık ÜÇ farklı test akışından beslenebiliyor
// — kaynağı ayırt etmek önemli çünkü GÜVENİLİRLİKLERİ farklı: LOCKED_EXAM
// (Test 2, kilitli+gözetimli) > AI_TEST (Faz 2'nin adaptif testi) >
// PRACTICE_SELF_REPORT (Test 1, öğrencinin KENDİ beyanı — en az güvenilir,
// ama yine de mock veriden çok daha değerli bir sinyal).
enum XraySource {
  AI_TEST // XrayTestSession sonucundan otomatik hesaplandı
  PRACTICE_SELF_REPORT // Test 1 — öğrencinin cevap anahtarı sonrası kendi işaretlemesi
  LOCKED_EXAM // Test 2 — kilitli, yönetici atamalı sınav sonucu (uygulama İÇİ quiz)
  TEACHER_OVERRIDE // öğretmen otomatik puanı elle düzeltti
  // Faz (2026-09-05) — "Ölçme Değerlendirme" köprüsü: GERÇEK bir dershane
  // denemesinden (Exam/ExamNetResult, kağıt üzerinde yapılan sınav)
  // hesaplanan kazanım kırılımı. LOCKED_EXAM'dan BİLEREK AYRI — o
  // uygulama İÇİ bir quiz'i, bu GERÇEK bir kağıt sınavı temsil ediyor;
  // ikisinin güvenilirlik/ölçek farkı ileride analiz/filtre için önemli
  // olabilir. Bkz. lib/server/exams/subtopic-breakdown.ts.
  PAPER_EXAM
}

enum XrayTestStatus {
  IN_PROGRESS
  COMPLETED
}

// Soru havuzu. subtopicId, CURRICULUM_TREE (lib/mock-data.ts) içindeki
// subtopic.id ile eşleşir — CurriculumProgress'teki AYNI referans deseni.
model XrayQuestion {
  id            String   @id @default(cuid())
  subject       String
  subtopicId    String
  difficulty    Int // 1 (kolay) - 5 (zor) — adaptif motorun sıralama ekseni
  prompt        String
  options       String[]
  correctAnswer String
  createdAt     DateTime @default(now())

  answers XrayTestAnswer[]

  @@index([subject, subtopicId, difficulty])
}

// Bir öğrencinin BİR ders için başlattığı tanı testi oturumu.
model XrayTestSession {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  status      XrayTestStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  answers XrayTestAnswer[]

  @@index([studentId])
}

// Tek bir sorunun cevabı. subtopicId BİLEREK denormalize edilir (soru
// silinse/değişse bile hangi konuya ait olduğu bilgisi kalıcı kalır, aynı
// zamanda konu bazlı skor hesaplanırken her seferinde XrayQuestion'a JOIN
// atmaya gerek kalmaz).
model XrayTestAnswer {
  id             String          @id @default(cuid())
  sessionId      String
  session        XrayTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       XrayQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subtopicId     String
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime        @default(now())

  @@index([sessionId])
  @@index([subtopicId])
}

// Bir öğrencinin BİR dersteki BİR alt konudaki GÜNCEL ustalık seviyesi —
// XrayTestSession tamamlandığında otomatik upsert edilen, hızlı okuma için
// önbelleklenmiş bir özet satırı (ham XrayTestAnswer'ları her dashboard
// yüklemesinde yeniden toplamamak için — bkz. Faz 3'teki kurum geneli
// liste ekranı). assessedById/note SADECE source=TEACHER_OVERRIDE iken
// dolu olur — bir öğretmen otomatik test sonucunu elle düzeltmek isterse.
model TopicMasteryAssessment {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         String
  subtopicId      String // CURRICULUM_TREE içindeki subtopic.id
  masteryScore    Int // 0-100
  source          XraySource @default(AI_TEST)
  sourceSessionId String? // source=AI_TEST iken hangi XrayTestSession'dan geldiği
  note            String?
  assessedById    String?
  assessedBy      Teacher?   @relation(fields: [assessedById], references: [id], onDelete: SetNull)
  assessedAt      DateTime   @default(now())

  @@unique([studentId, subtopicId])
  @@index([studentId])
  @@index([assessedById])
}

// Faz J — TopicMasteryAssessment'ın @@unique([studentId, subtopicId])
// kısıtı YÜZÜNDEN her yeni değerlendirme ESKİSİNİN ÜZERİNE upsert edilir;
// geçmiş sonuçlar SİLİNİR, zaman içindeki gelişim/trend hiçbir zaman
// GÖRÜLEMEZ hale gelirdi. Bu tablo AYRI ve KALICI (append-only, hiçbir
// zaman update/upsert edilmez, sadece create) — TopicMasteryAssessment'a
// yazan HER YER (comprehension-assignment/complete, practice-attempt/
// complete, test-session/next-question) buraya da BİREBİR AYNI veriyle
// bir satır ekler. TopicMasteryAssessment'ın kendisi ve onu okuyan
// mevcut uçlar (results/[studentId], report/[studentId]) BİLEREK
// DOKUNULMADI — "güncel skor" ihtiyacı için hâlâ en hızlı/basit kaynak o;
// bu tablo SADECE trend grafikleri (bkz. mastery-history endpoint'i) için.
model TopicMasteryHistory {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         String
  subtopicId      String
  masteryScore    Int
  source          XraySource
  // TopicMasteryAssessment'taki AYNI alan (bkz. o modelin üstündeki not) —
  // source=PAPER_EXAM iken hangi Exam'dan geldiğini taşır ("etiketleme
  // sistemi", 2026-09-06): Röntgen/Video Ders Merkezi ekranlarında "hangi
  // denemeden geldi" rozetini bundan besleriz.
  sourceSessionId String?
  assessedAt      DateTime   @default(now())

  @@index([studentId, subtopicId, assessedAt])
}

// Faz P — Pomodoro modülündeki "kalıcı hedef kartları" deseninin Akademik
// Röntgen'e uyarlanmış hali: "Bu ay integral konusunu %80'e çıkar" gibi
// bir MASTERY SKORU hedefi (StudyGoal'daki soru/dakika sayısı YERİNE).
// achievedAt NULL iken "aktif" sayılır; başarıldı mı kontrolü BİR CRON
// GEREKTİRMİYOR — GET /api/xray/mastery-goals her çağrıldığında güncel
// skor >= targetScore olan aktif hedefleri LAZY olarak işaretler (bkz. o
// route'taki yorum). createdByRole SADECE gösterim/etiketleme içindir
// ("Öğretmenin koyduğu hedef" gibi) — yetki kontrolü ayrı, route'ta yapılır.
model XrayMasteryGoal {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       String
  subtopicId    String
  targetScore   Int
  createdByRole String // "STUDENT" | "TEACHER" | "ADMIN" — sadece etiket
  createdAt     DateTime  @default(now())
  achievedAt    DateTime?

  @@index([studentId, achievedAt])
}

// Faz N — "Unutma riski" aylık tarama testi (ALEKS "Knowledge Check"
// mantığı): kurum+sınıf seviyesi başına TEK satır, yönetici bunu açıp
// kapatabilir ve konusunu değiştirebilir. ENABLED iken bir cron job
// (bkz. app/api/cron/xray-monthly-screening) her gün nextRunAt <= now
// olan satırları bulup O SINIF SEVİYESİNDEKİ TÜM öğrencilere Test 1
// havuzundan (XrayPracticeQuestion) rastgele seçilmiş, en fazla
// MONTHLY_SCREENING_QUESTION_COUNT sorulu bir tarama testi atar — sonra
// nextRunAt'i intervalDays kadar ileri alır. configuredById, OTOMATİK
// atamaların XrayPracticeAttempt.assignedById alanına yazılacak admin'i
// taşır (o alan required — "sistem" diye ayrı bir kavram YOK, otomatik
// atama, ayarı açan yöneticinin adına yapılmış sayılır).
model XrayMonthlyScreeningConfig {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  grade          Int
  enabled        Boolean     @default(false)
  subject        String
  subtopicId     String
  intervalDays   Int         @default(30)
  nextRunAt      DateTime
  configuredById String
  configuredBy   Admin       @relation(fields: [configuredById], references: [id], onDelete: Cascade)
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())

  @@unique([institutionId, grade])
  @@index([enabled, nextRunAt])
}

// ----------------------------------------------------------------------------
// Akademik Röntgen — Faz A: iki ayrı test türü (Kampüs V2 Part 6 devamı)
// ----------------------------------------------------------------------------
//
// Faz 2'deki tek XrayQuestion modeli (basit adaptif tanı testi) YETERSİZ
// kaldı — kullanıcı isteği iki YAPISALca farklı test türü tanımlıyor, bu
// yüzden BİLEREK ayrı model ağaçlarına bölünür (tek bir modele sıkıştırmak
// nullable alan yığınına yol açardı):
//
// 1) Test 1 "Konu Bilgisi" (XrayPracticeQuestion) — öğrencinin kendi
//    panelinden SERBESTÇE açtığı, süre/kilit OLMAYAN bir soru bankası.
//    Açık uçlu + çoktan seçmeli karışık, kolaydan (temel kural/tanım) zora
//    (çok adımlı) sıralı. Çözüm anlatımı her soruda VAR — "cevap
//    anahtarına ulaş" akışıyla test sonunda açılır.
// 2) Test 2 "Ne Kadar Anlamış" (XrayComprehensionQuestion) — yöneticinin
//    belirli bir öğrenciye belirli bir konu için ATADIĞI, kilitli tam ekran
//    sınav. SADECE çoktan seçmeli — çünkü her ŞIK (doğru olan dahil) hangi
//    kazanımı/yanlış anlamayı temsil ettiği etiketlenir (bkz.
//    XrayComprehensionOption.diagnosis) — gerçek bir "yanlış cevap analizi".
//    Açık uçlu bir soruda şık bazlı bu analiz mümkün olmadığı için Test
//    2'de format seçimi YOK, hep MCQ.
//
// "checks" alanı HER İKİ türde de var (Test 1'de soru bazlı, Test 2'de hem
// soru hem şık bazlı) — kullanıcının "her sorunun bilinçli arkada yorumu
// olmalı" isteğinin karşılığı; Faz D'deki analiz motoru bunu okuyacak.

// Test 1 — Konu Bilgisi soru bankası. Faz F revizyonu: gerçek içerik
// üretim formatı (kullanıcının kendi hazırladığı JSON) MCQ İÇERMİYOR —
// tamamen açık uçlu, "test_adi" ile adlandırılmış bir ÇALIŞMA YAPRAĞI
// (testId/testName) altında gruplu, her sorunun kendi kazanımId'si var
// (subtopicId'den DAHA İNCE bir etiket — bir subtopic'in altında onlarca
// farklı kazanım olabilir, bkz. örnek: "9. Sınıf - İntegral" konusu tek
// subtopicId ama 12+ farklı kazanımId). Bu yüzden format/options/difficulty
// KALDIRILDI (MCQ hiç yok, zorluk sıralaması yerine testin kendi soruNo
// sırası kullanılıyor) — testId/testName/kazanimId/order EKLENDİ.
// ⚠️ "variant" (Faz Z4) burada kodun başka yerindeki "Test 1"/"Test 2"
// isimlendirmesiyle (XrayPracticeAttempt="Test 1", aşağıdaki yorumdaki
// "Test 2"=comprehension) KARIŞTIRILMAMALI — o isimler UYGULAMANIN İKİ AYRI
// ÖZELLİĞİni ayırt eder. "variant" ise TAMAMEN Test 1'in (bu model) İÇİNDE,
// kullanıcının istediği 3 havuz türünü ayırt eder:
//   "genel"    — konunun (temanın) TÜMÜNÜ kapsayan 30 soruluk havuz, sorular
//                o temanın TÜM alt konularına dağılır (her soru kendi
//                subtopicId'sine etiketlenir, ama bir TUR/round tema
//                genelinde tek bir bütündür — bkz. XrayPoolGenerationRound).
//   "alt_konu" — TEK bir alt konuya özel 10 soruluk havuz.
//   "yeterlilik" — konu genelinde daha zor/kapsamlı 20 soruluk havuz.
// Mevcut 30 gerçek üretim sorusu (İntegral) yapısal olarak "genel" ile
// örtüştüğü için @default("genel") ile geriye dönük uyumlu bırakıldı.
model XrayPracticeQuestion {
  id            String   @id @default(cuid())
  subject       String
  subtopicId    String
  variant       String   @default("genel") // "genel" | "alt_konu" | "yeterlilik" — bkz. yukarıdaki not
  testId        String // HANGİ yüklemeden geldiği (içerik yönetimi/izlenebilirlik içindir — bkz. Faz G, öğrenci artık belirli bir testId SEÇMİYOR, havuzdan kazanimId bazlı rastgele çekiliyor)
  testName      String // "Test 1: İki Aşamalı Kontrollü Çalışma Yaprağı" — denormalize, her satırda tekrar eder
  order         Int // soruNo — aynı kazanimId'nin havuzdaki tipik gösterim sırasını belirlemekte kullanılır
  kazanimId     String // örn. "INTEGRAL_KUVVET_KURALI" — Faz G'nin rastgele seçim biriminin ANA anahtarı
  prompt        String // questionText
  correctAnswer String // finalAnswer
  solution      String // detailedSolution — cevap anahtarında gösterilir
  checks        String // diagnosticComment — öğrenci bu soruyu işaretlerse hangi eksiklik anlaşılır
  createdAt     DateTime @default(now())

  answers          XrayPracticeAnswer[]
  attemptQuestions XrayPracticeAttemptQuestion[]

  @@index([subject, subtopicId])
  @@index([subject, subtopicId, kazanimId])
  @@index([subject, variant])
  @@index([testId])
}

// Faz Z3/Z4 — soru havuzu otomasyon worker'ının (scripts/xray-generate-
// question-pool.ts) ilerleme/durum takibi. Worker Vercel'de DEĞİL, uzun
// süre çalışan bir arka plan süreci olarak (yerel/CI) çalışır — bu tablo
// onun TEK gerçek durum kaynağıdır: kesintiye uğrarsa hangi (subject,
// variant, unitId, round) dörtlüsünün zaten "success" olduğuna bakıp
// kaldığı yerden devam eder, aynı turu tekrar üretip token harcamaz.
//
// "unitId" variant'a göre DEĞİŞİR: "genel"/"yeterlilik" için bu bir TEMA
// (CurriculumTopic.id) — tur o temanın TÜM alt konularını kapsar; "alt_konu"
// için bu doğrudan bir CurriculumSubtopic.id'dir — tur TEK bir alt konuyu
// kapsar. "blueprint", 1. turda kilitlenen soru-slotu yapısıdır (30/10/20
// elemanlı) — 2. ve sonraki turlarda AYNEN modele yeniden verilir (modelin
// "hatırlamasına" güvenilmez, her çağrıda taze enjekte edilir) — bkz.
// lib/server/xray/practice-pool.ts'teki occurrence eşleştirmesinin doğru
// çalışması için turlar arası kazanım YAPISININ (sayı+sıra, "genel"/
// "yeterlilik" için ayrıca subtopicId dağılımının) tutarlı kalması
// gerekliliği.
model XrayPoolGenerationRound {
  id           String   @id @default(cuid())
  subject      String
  variant      String // "genel" | "alt_konu" | "yeterlilik"
  unitId       String // "genel"/"yeterlilik": topicId (tema) — "alt_konu": subtopicId
  roundNumber  Int
  status       String // "success" | "failed"
  blueprint    Json? // "genel"/"yeterlilik": [{subtopicId,kazanimId}, ...] — "alt_konu": [kazanimId, ...]
  testId       String? // başarılıysa bu turun XrayPracticeQuestion.testId'si
  attempts     Int      @default(0)
  tokensUsed   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subject, variant, unitId, roundNumber])
  @@index([subject, variant, unitId])
  @@index([status])
}

// Faz Z10 — kullanıcı talebi: "sistem kendini besleyerek daha kusursuz
// hale gelsin". XrayPoolGenerationRound sadece SON durumu (başarılı/
// başarısız) ve ÖZET hata mesajını tutuyor — bir turun 3 denemesinde
// tespit edilen TÜM ayrı sorunlar (düzeltilmiş olsalar bile) kayıp
// gidiyordu, sadece o an konsola loglanıyordu. Bu tablo HER TESPİT EDİLEN
// sorunu (deterministic kontrolden mi geldi, AI denetiminden mi geldi,
// düzeltilip düzeltilmediği) kalıcı olarak tutar — böylece zamanla
// (worker günlerce/haftalarca çalışacağı için) tekrar eden hata
// kalıplarını GERÇEK VERİYLE analiz edip prompt'ları buna göre
// güncellemek mümkün olur (elle konsol okumaya bağımlı kalmadan).
model XrayPoolQaIssueLog {
  id          String   @id @default(cuid())
  subject     String
  variant     String
  unitId      String
  roundNumber Int
  soruNo      Int
  source      String // "deterministic" | "ai-verify" | "ai-recheck"
  reason      String
  resolved    Boolean // bu spesifik tespitten SONRA o soru başarıyla düzeltildi mi
  createdAt   DateTime @default(now())

  @@index([subject, variant, unitId])
  @@index([source])
}

// Worker'ın TEK satırlık global anahtarı — /platform panelinden
// Duraklat/Devam Et ve HANGİ variant(lar)ın aktif (worker'ın sırayla
// işleyeceği) olduğu buradan kontrol edilir. Worker her turdan ÖNCE bu
// satırı taze okur (paused=true ise hemen durur) — bu yüzden panelden
// "Duraklat" basmak, worker'ı ID'siyle öldürmeye gerek kalmadan bir
// sonraki turdan önce durdurur. Birden fazla variant AYNI ANDA aktif
// olabilir (kullanıcı "3'ünü birlikte" isteyebilir) — worker bunları
// GERÇEK PARALEL istek olarak DEĞİL, sırayla (round-robin) işler; aynı API
// hesabına eşzamanlı çoklu istek atıp rate-limit'e (429) çarpma riskini
// almadan, aynı toplam ilerlemeyi güvenle sağlar. dailyTokenBudget
// aşılırsa worker de kendini otomatik durdurur (kazara aşırı harcamaya
// karşı donanım dışı bir güvenlik freni — bkz. kullanıcının "sıfır hatayla
// en minimum token yemeli" talebi).
model XrayPoolGenerationControl {
  id               String   @id @default("singleton")
  paused           Boolean  @default(true)
  activeVariants   Json     @default("[\"genel\"]") // string[] — worker'ın round-robin işleyeceği variant'lar
  dailyTokenBudget Int      @default(15000000)
  tokensUsedToday  Int      @default(0)
  tokensUsedTotal  Int      @default(0)
  budgetResetAt    DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Faz C — manuel QA sürecinin arka plana taşınmış hâli. Kullanıcı talebi:
// "en az senin incelediğin kadar detaylı" bir denetim, zaten ÜRETİLİP DB'ye
// yazılmış (ve generation-time verify-content.ts ile bir kez zaten süzülmüş)
// soru havuzunu İKİNCİ, daha titiz bir bağımsız AI geçişiyle (bkz.
// lib/server/xray/question-generation/qa-review-prompt.ts) yeniden denetler:
// hesap hatası, yazım, müfredat uygunluğu, ölçme-değerlendirme kalitesi VE
// diagnosticComment'in soruya özgü/gerçek olup olmadığını (bkz. bu oturumda
// elle bulunan Bulgu #2/#3 — 572 satırlık toplu şablon-kopyalama hatası)
// kontrol eder. Worker (scripts/xray-qa-review.ts) üretim worker'ıyla AYNI
// "paused okuma" desenini kullanır ama TAMAMEN AYRI bir singleton satırdır —
// ikisi birbirinden bağımsız duraklatılabilir.
// ----------------------------------------------------------------------------
model XrayQaReviewControl {
  id        String   @id @default("singleton")
  paused    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Hangi turun (XrayPoolGenerationRound.testId) bu denetimden GEÇTİĞİNİ kalıcı
// tutar — worker kaldığı yerden devam edebilsin diye (üretim worker'ındaki
// XrayPoolGenerationRound'un aynı mantığı, ama bu AYRI bir geçiş olduğu için
// ayrı bir tabloda).
model XrayQaReviewedRound {
  id            String   @id @default(cuid())
  testId        String   @unique
  subject       String
  variant       String
  unitId        String
  roundNumber   Int
  questionCount Int
  issuesFound   Int      @default(0)
  tokensUsed    Int      @default(0)
  reviewedAt    DateTime @default(now())

  @@index([subject])
}

// Bu denetimde tespit edilen HER sorun — before/after TAM METİN olarak (bu
// oturumdaki 572 satırlık toplu düzeltmede orijinal metni arşivlemeden
// üzerine yazma hatasından ders alınarak, bu sefer KASITLI olarak önce
// snapshot alınır, SONRA düzeltme denenir). relatedFindingId, bir bulgunun
// tetiklediği "aynı kazanımı TÜM havuzda ara" taramasında bulunan EK
// örnekleri kök bulguya bağlar (kullanıcı talebi: "1 sorun yakaladığında o
// sorunu tüm sorularda arasın hepsinde düzeltsin").
model XrayQaFinding {
  id                  String    @id @default(cuid())
  questionId          String
  testId              String
  subject             String
  unitId              String
  soruNo              Int
  kazanimId           String
  category            String // "hesap-hatasi" | "yazim" | "mufredat" | "olcme-degerlendirme" | "tani-notu-uyumsuz" | "diger"
  severity            String // "kritik" | "orta" | "dusuk"
  summary             String
  beforePrompt        String
  beforeCorrectAnswer String
  beforeSolution      String
  beforeChecks        String
  afterPrompt         String?
  afterCorrectAnswer  String?
  afterSolution       String?
  afterChecks         String?
  status              String    @default("open") // "open" | "fixed" | "fix-failed"
  relatedFindingId    String?
  createdAt           DateTime  @default(now())
  fixedAt             DateTime?

  @@index([subject, status])
  @@index([testId])
  @@index([kazanimId])
  @@index([relatedFindingId])
}

// Kullanıcı talebi: panelde "şurda sorun buldum, bakıyorum, düzelttim, şimdi
// taramaya devam ediyorum" tarzı CANLI, insan-okunur Türkçe bir akış görmek
// istiyor — worker'ın konsol log'unun statik özet tablolara indirgenmeden
// AYNEN panelde de görünmesi için. message zaten TAMAMEN Türkçe/insan-okunur
// yazılır (worker'ın console.log'larıyla BİREBİR aynı metin) — panel bunu
// olduğu gibi listeler, ayrıca bir çeviri/formatlama katmanı GEREKMEZ.
model XrayQaActivityLog {
  id        String   @id @default(cuid())
  subject   String
  level     String // "info" | "found" | "fixed" | "manual" | "error"
  message   String
  createdAt DateTime @default(now())

  @@index([subject, createdAt])
}

// Test 1'in bir "oturumu" — süre/kilit yok, ama Faz H revizyonuyle artık
// öğrenci KENDİ BAŞINA başlatamıyor, TIPKI Test 2 gibi yönetici ataması
// gerekiyor (kullanıcı kararı: "öğrenci kafasına göre test almayacak,
// sadece yönetim üzerinden olacak"). assignedById/assignedAt atama anını,
// status (aynı XrayAssignmentStatus enum'u Test 2 ile PAYLAŞILIR) akışı
// takip eder: ASSIGNED (atandı, öğrenci henüz açmadı) -> IN_PROGRESS
// (öğrenci ilk açtı, startedAt o an yazılır) -> COMPLETED.
//
// Faz G'nin havuz mantığı DEĞİŞMEDİ: kullanıcı aynı konu için onlarca
// ayrı test yükleyecek (10 test × 30 soru = 300 sorulu bir HAVUZ) — TEK
// bir testId'ye bağlı sabit bir soru seti YOK. Atama anında subject+
// subtopicId havuzundaki sorular kazanimId'ye göre gruplanır, HER
// kazanımdan RASTGELE bir soru çekilir (bkz. lib/server/xray/practice-pool.ts)
// ve bu seçim XrayPracticeAttemptQuestion'a SABİTLENİR.
model XrayPracticeAttempt {
  id           String               @id @default(cuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      String
  subtopicId   String
  variant      String               @default("genel") // "genel" | "alt_konu" | "yeterlilik" — bkz. XrayPracticeQuestion.variant yorumu. Atama anında havuz BU alana göre filtrelenir (route.ts) — filtrelenmezse "genel" (tema geneli, 30 soru) ve "alt_konu" (tek alt konu, 10 soru) havuzları AYNI subtopicId altında karışırdı.
  assignedById String
  assignedBy   Admin                @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  status       XrayAssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  questions XrayPracticeAttemptQuestion[]
  answers   XrayPracticeAnswer[]

  @@index([studentId])
  @@index([assignedById])
}

// Bir attempt için havuzdan RASTGELE seçilip SABİTLENEN soru listesi —
// order, kazanımın havuzdaki tipik sırasına göre (bkz. seçim mantığı,
// min(order) per kazanimId) belirlenir, gösterim sırasını korur.
model XrayPracticeAttemptQuestion {
  id         String               @id @default(cuid())
  attemptId  String
  attempt    XrayPracticeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   XrayPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// wasCorrect: tamamen açık uçlu bir testte otomatik derecelendirme YOK —
// bu HER ZAMAN öğrencinin "Yapamadıklarım" listesindeki kendi beyanıdır
// (işaretlenmemiş = doğru yapmış sayılır, bkz. .../complete route'u).
model XrayPracticeAnswer {
  id         String               @id @default(cuid())
  attemptId  String
  attempt    XrayPracticeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   XrayPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  wasCorrect Boolean
  answeredAt DateTime             @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// Test 2 — Ne Kadar Anlamış (kilitli, yönetici atamalı sınav) sorusu.
model XrayComprehensionQuestion {
  id         String   @id @default(cuid())
  subject    String
  subtopicId String
  difficulty Int
  prompt     String
  solution   String
  createdAt  DateTime @default(now())

  options XrayComprehensionOption[]
  answers XrayComprehensionAnswer[]

  @@index([subject, subtopicId])
}

// Her şık (doğru olan DAHİL) bir "diagnosis" taşır — o şık seçildiğinde
// öğrencinin konuyu TAM OLARAK nerede/nasıl yanlış anladığını anlatan bir
// metin (örn. "Kök içindeki çarpanı doğru ayırdı ama kök dışına çıkarmayı
// unuttu"). position, şıkkın gösterim sırası (A/B/C/D karışmasın diye).
model XrayComprehensionOption {
  id         String                    @id @default(cuid())
  questionId String
  question   XrayComprehensionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String // "A" | "B" | "C" | "D"
  text       String
  isCorrect  Boolean
  diagnosis  String
  position   Int

  answers XrayComprehensionAnswer[]

  @@index([questionId])
}

enum XrayAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FLAGGED // kilit ihlali tespit edildi (sekme değiştirme/pencere kaybı, bkz. flagReason)
}

// Yöneticinin belirli bir öğrenciye belirli bir konu için attığı Test 2
// ataması. Bir öğrenci aynı konudan yeniden test alabilir (yeni bir
// assignment) — bu yüzden studentId+subtopicId üzerinde @@unique YOK.
model XrayComprehensionAssignment {
  id           String               @id @default(cuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      String
  subtopicId   String
  assignedById String
  assignedBy   Admin                @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  status       XrayAssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  flagReason   String? // örn. "14:32'de sekme değiştirildi, sınav otomatik teslim edildi"

  answers XrayComprehensionAnswer[]

  @@index([studentId])
  @@index([assignedById])
}

model XrayComprehensionAnswer {
  id               String                      @id @default(cuid())
  assignmentId     String
  assignment       XrayComprehensionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId       String
  question         XrayComprehensionQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   XrayComprehensionOption     @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  answeredAt       DateTime                    @default(now())

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
}

// ----------------------------------------------------------------------------
// Video Ders Merkezi (Hub'daki 4. modül) — Faz 1
// ----------------------------------------------------------------------------

// Kullanıcı kararı (2026-09-03) — ÖNCE Cloudflare R2 (kendi depomuz +
// tarayıcı-içi ffmpeg.wasm dönüştürücü) denendi, ama gerçek kullanımda
// yavaş/tutarsız çıktı ("kafasına göre çalışıyor") — YouTube'a (gizli
// link) DÖNÜLDÜ: yönetici videoyu YouTube'a yükler, biz SADECE video ID'yi
// saklayıp kendi arayüzümüzde embed ediyoruz (bkz. lib/client/youtube.ts).
// Depolama/dönüştürme/CDN sorunlarının hiçbiri bizim sorunumuz değil artık
// — bedeli küçük bir YouTube logosu (bkz. kullanıcıyla yapılan tartışma).
// "grade/subject/topic" — Röntgen'in CURRICULUM_TREE'sinin AKSİNE serbest
// metin: video merkezi TÜM sınıf seviyelerini (1-12) ve TÜM dersleri
// kapsıyor, Röntgen'in Matematik-özel/9-12 kısıtı burada YOK.
// Kullanıcı geri bildirimi (2026-09-04) — YouTube video baytlarını ALMASI
// ile videonun GERÇEKTEN oynatılabilir olması AYRI şeyler: bayt alımı
// bitince (bkz. uploadToYoutube) YouTube kendi tarafında ayrıca bir
// "işleme" adımı yapıyor (saniyeler-dakikalar sürebilir) — bu bitmeden
// embed player'da video açılmıyor/hata veriyordu. Bu yüzden kart bu
// alanla "hazır olana kadar" kilitli/tıklanamaz tutuluyor (bkz.
// video-portal-panel.tsx > VideoCard).
enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

model Video {
  id              String            @id @default(cuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  grade           Int
  subject         String
  topic           String
  // Faz (2026-09-05, sağlamlaştırma) — DB satırı artık R2→YouTube aktarımı
  // BAŞLAMADAN ÖNCE oluşturuluyor (bkz. app/api/videos/route.ts > handlePost),
  // bu yüzden youtubeId aktarım bitene kadar NULL olabilir — sunucusuz
  // fonksiyon aktarım sırasında (ör. Vercel'in süre sınırı) öldürülürse
  // artık en azından KAYIP OLMAYAN, yeniden denenebilir bir satır kalıyor
  // (eskiden create() aktarım BİTTİKTEN sonra çağrılıyordu, yarıda kesilen
  // bir aktarım DB'de hiçbir iz bırakmıyordu — sessizce kayboluyordu).
  youtubeId       String? // YouTube video ID'si (11 karakter) — embed/thumbnail URL'leri lib/client/youtube.ts'te türetilir
  status          VideoStatus       @default(PROCESSING)
  // Sadece status=FAILED iken dolu — YouTube'un rejectionReason/
  // processingFailureReason alanı ya da bizim "zaman aşımı" tespitimiz
  // (bkz. checkYoutubeProcessingStatus, GET /api/videos). Amaç: "başarısız"
  // her zaman AYNI genel mesajı göstermek yerine yöneticiye GERÇEK sebebi
  // (kota doldu mu, dosya reddedildi mi, kontrol zaman aşımına mı uğradı)
  // gösterebilmek.
  failureReason   String?
  // "Kaldığı yerden devam" özelliği için — YouTube API'sine ayrı bir
  // sorgu atmak yerine, bir öğrenci videoyu İLK kez oynattığında tarayıcı
  // tarafında zaten bilinen süre buraya bir kere yazılır (bkz. POST
  // /api/videos/assigned/[id]/watched > durationSeconds).
  durationSeconds Int?
  createdById     String?
  createdBy       Admin?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  assignments     VideoAssignment[]

  @@index([institutionId, grade, subject])
}

// Bir videonun hangi öğrencilere atandığını tutar — kullanıcı isteği
// "istediği zaman istediği öğrencinin paneline tek tuşla atayacak". Toplu
// atama (şube/sınıf) API katmanında (route.ts) N tane satıra açılır — Xray
// atama modellerindeki (TopicMasteryAssessment vb.) AYNI desen, ayrı bir
// "hedef" tablosu YOK, doğrudan öğrenci bazlı satırlar.
model VideoAssignment {
  id                  String    @id @default(cuid())
  videoId             String
  video               Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt          DateTime  @default(now())
  watchedAt           DateTime?
  // "Kaldığı yerden devam" (2026-09-05) — öğrenci oynatırken periyodik
  // olarak (bkz. POST /api/videos/assigned/[id]/progress) güncellenir;
  // bir sonraki açılışta YoutubePlayer bu saniyeden itibaren başlar (bkz.
  // youtube-player.tsx > initialPositionSeconds). Video.durationSeconds
  // ile birlikte yönetici tarafında "% kaç izlendi" hesaplanabiliyor (bkz.
  // assignment-history route'u).
  lastPositionSeconds Int?

  @@unique([videoId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Ödeme Takip (Hub'daki 5. modül) — Faz 1: Gelir Yönetimi + Kontrol Paneli
// ----------------------------------------------------------------------------
//
// Faz 1 kapsamı BİLİNÇLİ olarak dar: sadece öğrenci tahsilat/taksit takibi +
// kasa/banka bakiyesi (manuel kayıt). Gider Yönetimi, Sözleşme, Bordro,
// Çoklu Şube/Bütçe, Mağaza, Raporlar ve gerçek ödeme gateway'i entegrasyonu
// Faz 2+'ya bırakıldı (bkz. plan dosyası).
//
// İleride gerçek bir ödeme gateway'i (iyzico/PayTR) eklendiğinde şema
// DEĞİŞMEDEN genişleyebilsin diye Payment.status/source ve rezerve
// gatewayProvider/gatewayReference alanları şimdiden var — manuel kayıtlar
// hep status=COMPLETED/source=MANUAL ile başlar, gateway eklenince online
// ödemeler PENDING başlayıp webhook ile COMPLETED/FAILED'a döner.

enum PaymentAccountType {
  CASH // Nakit Kasa
  BANK // Banka Hesabı
}

model PaymentAccount {
  id            String                   @id @default(cuid())
  institutionId String
  institution   Institution              @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name          String // "Nakit Kasa", "Ziraat Bankası TL Hesabı"
  type          PaymentAccountType
  isActive      Boolean                  @default(true)
  payments      Payment[]
  expenses      Expense[]
  transfersOut  AccountTransfer[]        @relation("TransferFrom")
  transfersIn   AccountTransfer[]        @relation("TransferTo")
  refunds       EnrollmentCancellation[] @relation("RefundFrom")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([institutionId])
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Installment {
  id                     String                  @id @default(cuid())
  institutionId          String
  institution            Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId              String
  student                Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  title                  String // "2026-2027 Eğitim Ücreti - Taksit 3/12"
  amount                 Decimal                 @db.Decimal(12, 2)
  dueDate                DateTime
  status                 InstallmentStatus       @default(PENDING)
  // Bu taksit için veliye en son ne zaman ödeme hatırlatma SMS'i gidildiği
  // (bkz. app/api/payments/principal/reminders). Amaç: aynı veliye üst üste
  // hatırlatma gönderilmesini önlemek — arayüz "3 saat önce hatırlatıldı"
  // diyerek yöneticiyi uyarır.
  lastReminderAt         DateTime?
  payments               Payment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  product                Product?                @relation(fields: [productId], references: [id])
  productId              String?
  installmentAdjustments InstallmentAdjustment[]

  @@index([institutionId])
  @@index([studentId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
}

enum PaymentStatus {
  COMPLETED // manuel kayıtlar hep bununla başlar
  PENDING // ileride: gateway'den dönüş bekleniyor
  FAILED
  REFUNDED // para GERÇEKTEN geri verildi (kayıt iptali vb.)
  // Hatalı kayıt: para hiç alınmamıştı ya da yanlış girildi. REFUNDED'dan
  // FARKLIDIR — ortada geri verilecek para yoktur, kayıt baştan yanlıştır.
  // Tahsilat SİLİNMEZ: tüm hesaplama sorguları status="COMPLETED"
  // filtrelediği için iptal edilen kayıt bakiye/rapor/yaşlandırma/
  // hatırlatmalardan kendiliğinden düşer, ama denetim izi korunur.
  VOIDED
}

enum PaymentSource {
  MANUAL
  ONLINE // ileride gerçek gateway entegrasyonu
}

// ----------------------------------------------------------------------------
// Kayıt İptali & İade (Ödeme Takip Faz 11)
// ----------------------------------------------------------------------------
//
// Öğrenci yıl ortasında ayrıldığında iki şey olmalı: (1) kalan taksitler
// iptal edilmeli, (2) fazla ödenmişse iade hesaplanmalı.
//
// İade neden GİDER olarak kaydedilmiyor: iade bir işletme gideri değil,
// GELİRİN GERİ ALINMASIDIR. Gider yazılsaydı kâr/zarar ve gider kategori
// raporları bozulur, "bu ay kirası mı yüksek yoksa iademiz mi çok" sorusu
// anlamsızlaşırdı. Bu yüzden virman gibi AYRI bir hareket: kasa
// bakiyesinden düşer, gelir/gider tablosunu kirletmez.
model EnrollmentCancellation {
  id                        String          @id @default(cuid())
  institutionId             String
  institution               Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId                 String
  student                   Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reason                    String
  // İptal anındaki fotoğraf — sonradan "bu iade neye göre hesaplandı"
  // sorusunun cevabı olsun diye hepsi kaydediliyor.
  cancelledInstallmentCount Int
  cancelledAmount           Decimal         @db.Decimal(12, 2) // iptal edilen kalan borç
  totalPaid                 Decimal         @db.Decimal(12, 2) // o güne kadar tahsil edilen
  refundAmount              Decimal         @default(0) @db.Decimal(12, 2)
  // İade hangi kasadan/bankadan çıktı — bakiyeden buradan düşülür.
  refundAccountId           String?
  refundAccount             PaymentAccount? @relation("RefundFrom", fields: [refundAccountId], references: [id], onDelete: Restrict)
  refundedAt                DateTime?
  createdByAdminId          String
  createdByAdmin            Admin           @relation("CancellationCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt                 DateTime        @default(now())

  @@index([institutionId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Ödeme Sözü Takibi (Ödeme Takip Faz 10)
// ----------------------------------------------------------------------------
//
// Gecikmiş ödeme için veli arandığında "15'inde ödeyeceğim" denir ve bu
// söz hiçbir yerde tutulmaz: ertesi hafta ya kimse takip etmez ya da aynı
// veli tekrar aranıp rahatsız edilir.
//
// Sözün DURUMU saklanmaz, OKUMA ANINDA hesaplanır (bkz. promises route):
// söz verildikten sonra vaat edilen tutar kadar tahsilat yapıldıysa
// "tutuldu", vade geçtiyse ve ödeme yoksa "tutulmadı". Böylece veli ödeme
// yaptığı anda söz kendiliğinden kapanır — kimsenin elle işaretlemesi
// gerekmez ve durum asla bayatlamaz.
model PaymentPromise {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId        String
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  promisedAmount   Decimal     @db.Decimal(12, 2)
  promisedDate     DateTime
  note             String?
  // Elle kapatma (örn. "veli vazgeçti, yapılandırmaya gidildi") — doluysa
  // otomatik hesap devre dışı kalır.
  closedAt         DateTime?
  closedReason     String?
  createdByAdminId String
  createdByAdmin   Admin       @relation("PromiseCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Taksit Erteleme & Yapılandırma (Ödeme Takip Faz 9)
// ----------------------------------------------------------------------------
//
// Dershanede haftalık yaşanan iki durum: (1) "bu ay ödeyemiyorum, gelecek
// aya atalım", (2) "kalan borcumu yeniden bölelim". İkisi de vade/tutar
// değiştirdiği için DENETİM İZİ şart — sonradan "bu taksit neden ertelendi,
// kim izin verdi" sorusunun cevabı olmalı.

enum InstallmentAdjustmentType {
  POSTPONE // vade ötelendi
  RESTRUCTURE // kalan borç yeni bir plana bölündü
}

model InstallmentAdjustment {
  id               String                    @id @default(cuid())
  institutionId    String
  institution      Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId        String
  student          Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // Ertelemede tek taksit; yapılandırmada null (birden fazla taksiti
  // kapsar, ayrıntı affectedCount/amount alanlarında).
  installmentId    String?
  installment      Installment?              @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  type             InstallmentAdjustmentType
  previousDueDate  DateTime?
  newDueDate       DateTime?
  // Yapılandırmada: kapatılan taksit sayısı ve yeniden bölünen kalan tutar.
  affectedCount    Int?
  amount           Decimal?                  @db.Decimal(12, 2)
  reason           String
  createdByAdminId String
  createdByAdmin   Admin                     @relation("AdjustmentCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now())

  @@index([institutionId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// İndirim & Burs (Ödeme Takip Faz 7)
// ----------------------------------------------------------------------------
//
// Dershane gerçeği: neredeyse HİÇBİR öğrenci liste fiyatından kayıt olmaz —
// kardeş indirimi, başarı bursu, erken kayıt, personel çocuğu... Bu bilgi
// sistemde tutulmadığında (a) "ne kadar burs dağıttık" sorusunun cevabı
// yoktur, (b) taksit planındaki tutarın NEDEN o rakam olduğu kayıt dışı
// kalır, (c) indirimi kimin onayladığı bilinmez.
//
// Uygulama anındaki liste/indirim/net tutarları kayda BASILIR (snapshot):
// indirim oranı sonradan değişse bile geçmiş plan olduğu gibi okunabilir
// kalır ve raporlar geriye dönük değişmez.

enum DiscountType {
  SIBLING // kardeş indirimi
  MERIT // başarı bursu
  EARLY_REGISTRATION // erken kayıt
  STAFF_CHILD // personel çocuğu
  FINANCIAL_AID // ihtiyaç bursu
  OTHER
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

model StudentDiscount {
  id                String            @id @default(cuid())
  institutionId     String
  institution       Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId         String
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  type              DiscountType
  valueType         DiscountValueType
  // PERCENTAGE ise 0-100 arası oran, FIXED ise doğrudan tutar.
  value             Decimal           @db.Decimal(12, 2)
  academicYear      String // "2025-2026"
  reason            String?
  // Taksit planı üretilirken doldurulan anlık kayıt (bkz. üstteki not).
  // Plan henüz üretilmediyse null'dır.
  appliedListAmount Decimal?          @db.Decimal(12, 2)
  appliedDiscount   Decimal?          @db.Decimal(12, 2)
  appliedAt         DateTime?
  isActive          Boolean           @default(true)
  approvedByAdminId String
  approvedByAdmin   Admin             @relation("DiscountApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([institutionId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Bütçe & Virman (Ödeme Takip Faz 6)
// ----------------------------------------------------------------------------
//
// VİRMAN: şimdiye kadar para yalnızca SİSTEME GİREBİLİYOR (Payment) veya
// SİSTEMDEN ÇIKABİLİYORDU (Expense) — oysa kurum sürekli kasadan bankaya
// para yatırır. Bu hareket ne gelir ne giderdir; toplam bakiyeyi
// DEĞİŞTİRMEZ, sadece hesaplar arasında yer değiştirir. Bu yüzden ayrı bir
// model: gider olarak kaydedilseydi kâr/zarar tablosu yanlış olurdu.
model AccountTransfer {
  id                String         @id @default(cuid())
  institutionId     String
  institution       Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  fromAccountId     String
  fromAccount       PaymentAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId       String
  toAccount         PaymentAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount            Decimal        @db.Decimal(12, 2)
  transferredAt     DateTime       @default(now())
  note              String?
  recordedByAdminId String
  recordedByAdmin   Admin          @relation("TransferRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())

  @@index([institutionId])
}

enum BudgetKind {
  INCOME
  EXPENSE
}

// Aylık bütçe hedefi. INCOME satırlarında categoryId NULL'dur (gelir tek
// kalemde planlanır); EXPENSE satırları gider kategorisi bazındadır —
// böylece "plan vs gerçekleşen" karşılaştırması kategori kırılımında
// yapılabilir (bkz. /api/payments/principal/budget).
model BudgetLine {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  year          Int
  month         Int // 1-12
  kind          BudgetKind
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  plannedAmount Decimal          @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([institutionId, year, month, kind, categoryId])
  @@index([institutionId])
}

// ----------------------------------------------------------------------------
// Ürün & Etkinlik Takibi (Ödeme Takip Faz 5)
// ----------------------------------------------------------------------------
//
// Kitap seti, gezi, deneme sınavı, kıyafet gibi EĞİTİM ÜCRETİ DIŞINDAKİ
// gelir kalemleri. Kritik tasarım kararı: bunlar AYRI bir tahsilat sistemi
// kurmaz — öğrenciye atandığında MEVCUT taksit defterine (Installment) bir
// satır olarak düşer (bkz. Installment.productId). Böylece kontrol paneli,
// gecikmiş listesi, hatırlatma SMS'i, yaşlandırma ve raporlar bu geliri
// HİÇ EK KOD OLMADAN görür; tek bir alacak defteri kalır.

enum ProductType {
  PRODUCT // kitap seti, kıyafet, malzeme
  EVENT // gezi, deneme sınavı, kamp
}

model Product {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name          String
  type          ProductType
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  // Sadece EVENT için anlamlı — geziye/denemeye ait tarih.
  eventDate     DateTime?
  // Kontenjan (opsiyonel) — dolduğunda yeni atama engellenir.
  capacity      Int?
  isActive      Boolean       @default(true)
  installments  Installment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([institutionId])
}

// ----------------------------------------------------------------------------
// Personel Ücret / Bordro (Ödeme Takip Faz 4)
// ----------------------------------------------------------------------------
//
// Demo verisinde giderin ~%68'i personel maaşıydı ve elle giriliyordu —
// bordro bu kalemi otomatikleştirir. Saatlik çalışan öğretmenin aylık ders
// saati HAFTALIK DERS PROGRAMINDAN (LessonSlot) türetilir; yönetici
// gerekirse üzerine yazabilir (tatil/telafi gerçek hayatta sapma yaratır).
//
// Bordro "ödendi" işaretlendiğinde TEK bir toplu Expense kaydı üretilir
// (kategori: Personel Maaş) — böylece kasa/banka bakiyesi ve gider
// raporları bordroyu otomatik görür, çift kayıt olmaz.

enum StaffPayType {
  MONTHLY_SALARY // sabit aylık ücret
  HOURLY // ders saati başına
}

// Personelin nasıl ücretlendirildiği. Teacher VEYA Admin'e bağlanır —
// ikisi de kurumun personelidir ama ayrı tablolarda tutulur.
model StaffSalaryProfile {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  teacherId     String?      @unique
  teacher       Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  adminId       String?      @unique
  admin         Admin?       @relation("AdminSalaryProfile", fields: [adminId], references: [id], onDelete: Cascade)
  payType       StaffPayType
  monthlyAmount Decimal?     @db.Decimal(12, 2)
  hourlyRate    Decimal?     @db.Decimal(12, 2)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([institutionId])
}

enum PayrollStatus {
  DRAFT // hesaplandı, üzerinde oynanabilir
  PAID // ödendi, Expense kaydı üretildi, artık değiştirilemez
}

model PayrollPeriod {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  year          Int
  month         Int // 1-12
  status        PayrollStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paidAt        DateTime?
  // Ödendiğinde üretilen toplu gider kaydı — SetNull: gider silinse bile
  // bordro geçmişi kaybolmamalı.
  expenseId     String?
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  items         PayrollItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([institutionId, year, month])
  @@index([institutionId])
}

model PayrollItem {
  id               String         @id @default(cuid())
  periodId         String
  period           PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  adminId          String?
  admin            Admin?         @relation("AdminPayrollItem", fields: [adminId], references: [id], onDelete: SetNull)
  // Personel sonradan silinse/pasifleşse bile bordro satırı okunabilir
  // kalsın diye ad ve rol ANLIK kopyalanır.
  staffName        String
  staffRole        String // "Öğretmen" | "Yönetici"
  payType          StaffPayType
  hours            Decimal?       @db.Decimal(8, 2) // saatlik personelde ders saati
  rate             Decimal?       @db.Decimal(12, 2)
  baseAmount       Decimal        @db.Decimal(12, 2)
  advanceDeduction Decimal        @default(0) @db.Decimal(12, 2)
  netAmount        Decimal        @db.Decimal(12, 2)
  note             String?
  advances         StaffAdvance[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([periodId])
}

// Avans — personele bordro dışında yapılan ön ödeme. Bir sonraki bordroda
// otomatik olarak netAmount'tan düşülür (düşüldüğü satır payrollItemId).
model StaffAdvance {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  teacherId     String?
  teacher       Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  adminId       String?
  admin         Admin?       @relation("AdminStaffAdvance", fields: [adminId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  paidAt        DateTime     @default(now())
  note          String?
  // Hangi bordro satırında mahsup edildi — null ise HENÜZ düşülmemiş
  // (bir sonraki bordroda otomatik yakalanır).
  payrollItemId String?
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([institutionId])
}

// ----------------------------------------------------------------------------
// Sözleşme Yönetimi (Ödeme Takip Faz 3)
// ----------------------------------------------------------------------------
//
// Öğrenci kayıt sözleşmesi: yönetici bir ŞABLONDAN sözleşme üretir, veliye
// süreli/tokenlı bir bağlantı gider, veli oturum AÇMADAN sözleşmeyi okuyup
// parmağıyla/fareyle imzalar (bkz. app/sozlesme/[token]). Token deseni
// ReportCardShareLink ile AYNI (bkz. lib/server/report-card/share-link.ts).

enum ContractStatus {
  DRAFT // oluşturuldu, veliye henüz gönderilmedi
  SENT // bağlantı paylaşıldı, imza bekleniyor
  SIGNED
  CANCELLED
}

model ContractTemplate {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  title         String
  // {ogrenci_adi}, {veli_adi}, {tutar} gibi yer tutucular içerir —
  // lib/server/sms/template-parser.ts'teki AYNI renderTemplate ile doldurulur.
  content       String
  isActive      Boolean           @default(true)
  contracts     StudentContract[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([institutionId])
}

model StudentContract {
  id               String            @id @default(cuid())
  institutionId    String
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // SetNull — şablon silinse bile İMZALANMIŞ sözleşme ASLA kaybolmamalı.
  templateId       String?
  template         ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title            String
  // ⚠️ Şablonun o ANDAKİ hali, yer tutucuları doldurulmuş şekilde BURAYA
  // kopyalanır. Şablon sonradan değiştirilse bile imzalanmış metin
  // DEĞİŞMEZ — hukuken imzalanan şey bu satırdaki metindir.
  content          String
  totalAmount      Decimal?          @db.Decimal(12, 2)
  installmentCount Int?
  status           ContractStatus    @default(DRAFT)
  shareToken       String            @unique
  expiresAt        DateTime
  // İmza kanıtı: imzalayanın beyan ettiği ad, yakınlık, çizdiği imzanın
  // PNG (base64 data URL) hali ve imza anı/IP'si.
  signerName       String?
  signerRelation   String?
  signatureData    String?
  signedAt         DateTime?
  signedIp         String?
  createdByAdminId String
  createdByAdmin   Admin             @relation("ContractCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([institutionId])
  @@index([studentId])
}

// Gider Yönetimi (Faz 2) — gelirin karşı tarafı. Kategoriler kurum bazında
// yönetilir (rakipteki "kategori tabloları" karşılığı); kurumun hiç
// kategorisi yoksa ilk okumada varsayılan set tohumlanır (bkz.
// app/api/payments/principal/expense-categories/route.ts > DEFAULT_CATEGORIES).
model ExpenseCategory {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  name          String
  isActive      Boolean      @default(true)
  expenses      Expense[]
  budgetLines   BudgetLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId])
}

// PENDING: gider kaydedildi ama HENÜZ ödenmedi (planlanan/borç) — kasa
// bakiyesini ETKİLEMEZ. PAID: ödendi, seçilen hesaptan DÜŞÜLÜR (bkz.
// accounts/dashboard route'larındaki bakiye hesabı: gelir - ödenen gider).
enum ExpenseStatus {
  PENDING
  PAID
}

model Expense {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Ödendiğinde hangi kasa/bankadan çıktığı. PENDING iken null olabilir —
  // ödeme anında (bkz. expenses/[id]/pay) seçilir.
  accountId         String?
  account           PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  title             String // "Eylül Elektrik Faturası"
  vendorName        String? // Tedarikçi/kurum adı
  amount            Decimal         @db.Decimal(12, 2)
  status            ExpenseStatus   @default(PENDING)
  dueDate           DateTime? // Son ödeme tarihi (PENDING giderler için)
  paidAt            DateTime?
  note              String?
  recordedByAdminId String
  recordedByAdmin   Admin           @relation("ExpenseRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: Restrict)
  payrollPeriods    PayrollPeriod[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([institutionId])
  @@index([categoryId])
}

model Payment {
  id                String         @id @default(cuid())
  institutionId     String
  institution       Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentId         String
  student           Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  installmentId     String?
  installment       Installment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  accountId         String
  account           PaymentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount            Decimal        @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus  @default(COMPLETED)
  source            PaymentSource  @default(MANUAL)
  // Makbuz numarası — kurum içinde artan sıra. Muhasebe belgesinin takip
  // edilebilir bir numarası olmalı; cuid insan-okur değil. Yeni
  // tahsilatlarda kayıt anında verilir; modül öncesinden kalan eski
  // kayıtlara ilk makbuz basımında atanır (bkz. receipt route).
  // @@unique'te null'lar çakışmaz (Postgres) — bu BURADA İSTENEN
  // davranıştır: numarası olmayan yüzlerce eski kayıt sorun çıkarmaz,
  // ama aynı numara aynı kurumda İKİ KEZ kullanılamaz.
  receiptNo         Int?
  // İptal denetim izi — kim, ne zaman, neden iptal etti.
  voidedAt          DateTime?
  voidReason        String?
  voidedByAdminId   String?
  voidedByAdmin     Admin?         @relation("PaymentVoidedBy", fields: [voidedByAdminId], references: [id], onDelete: SetNull)
  gatewayProvider   String? // Faz 2: "iyzico" | "paytr" — şimdilik hep null
  gatewayReference  String? // Faz 2: gateway işlem id'si — şimdilik hep null
  paidAt            DateTime       @default(now())
  note              String?
  recordedByAdminId String
  recordedByAdmin   Admin          @relation(fields: [recordedByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([institutionId, receiptNo])
  @@index([institutionId])
  @@index([studentId])
  @@index([installmentId])
}

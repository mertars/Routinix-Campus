# Neon (veya başka bir yönetilen Postgres) için — yerel Postgres kullanıyorsanız
# .env.example'daki docker-compose bağlantı dizesini kullanın.
#
# ÖLÇEK NOTU (FAZ 6): Uygulamanın ÇALIŞMA ZAMANI (bkz. lib/server/prisma.ts)
# burada Neon'un HAVUZLANMIŞ (pooled/PgBouncer, host adında "-pooler" geçen)
# bağlantı dizesini kullanmalı — çok sayıda kısa ömürlü isteğin Neon'un
# compute bağlantı limitini aşmasını önler. DIRECT_URL ise (aşağıda)
# HAVUZLANMAMIŞ doğrudan uçtur, SADECE Prisma Migrate için kullanılır (bazı
# şema değişiklikleri PgBouncer'ın transaction-pooling modunun desteklemediği
# oturum seviyesi özellikler ister). İkisini Neon konsolu > Connection
# Details'ten ayrı ayrı kopyalayın — aynı URL'yi ikisine de yapıştırmayın.
DATABASE_URL=""

# Prisma Migrate bazı sağlayıcılarda (örn. connection pooling arkasındaki
# Neon uçları) migration'lar için havuzlanmamış DOĞRUDAN bir bağlantı ister.
# Neon'da genelde DATABASE_URL ile aynı host'u, farklı bir bağlantı modunu
# gösterir — bkz. Neon konsolu > Connection Details.
DIRECT_URL=""

# JWT ile imzalı oturum/doğrulama token'ları için gizli anahtar (bkz. lib/server/env.ts).
# Üretimde ZORUNLUDUR ve en az 32 karakter olmalıdır (örn. `openssl rand -base64 48`).
# Geliştirmede boş bırakılırsa sabit bir dev yedeği kullanılır (konsola uyarı yazılır).
AUTH_SECRET=""

# SMS sağlayıcı seçimi: mock | netgsm | mutlusms | generic — bkz. .env.example
SMS_PROVIDER="mock"

# Sentry hata izleme (opsiyonel) — boş bırakılırsa SDK kurulu ama pasif kalır,
# hiçbir şey göndermez (bkz. sentry.*.config.ts). Bir Sentry projesi açıp
# "Client Keys (DSN)" sayfasından alınan değeri buraya yazın.
NEXT_PUBLIC_SENTRY_DSN=""
